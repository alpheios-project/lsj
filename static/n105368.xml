    <div class="alpheios-lex-entry" lemma-id="n105368" body-key=""><b><span class="alpheios-lex-greek" lang="grc">τρῐφάσιος</span></b> 
		<span class="alpheios-lex-greek" lang="grc">[ᾰ]</span>, <span class="alpheios-lex-greek" lang="grc">α</span>, <span class="alpheios-lex-greek" lang="grc">ον</span>, (<span class="alpheios-lex-greek" lang="grc">τρεῖς</span>) <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b><i>triple,</i>
			
				“<span class="alpheios-lex-greek" lang="grc">μουνομαχίη</span>”
				 <i><span class="en">
					Hdt.
					5.1
				</span></i>
			. </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>II.</b> in pl., much
			the same as <span class="alpheios-lex-greek" lang="grc">τρεῖς,</span>
			<i><span class="en">
				Id.
				1.95
			</span></i>, <i><span class="en">
				2.17
			</span></i>, al.; cf. <span class="alpheios-lex-greek" lang="grc">διφάσιος.</span>
		</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>III.</b>
			
				=
				<span class="alpheios-lex-greek" lang="grc">τρίφωνος</span>
			, <i><span class="en">
				Hsch.
			</span></i></div>
    </div> <div class="alpheios-lex-footnotes en"> </div>
