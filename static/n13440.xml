    <div class="alpheios-lex-entry" lemma-id="n13440" body-key=""><b><span class="alpheios-lex-greek" lang="grc">ἀποπλέω</span></b> , 
			Ep.
		
		<b><span class="alpheios-lex-greek" lang="grc">ἀποπλᾰν-πλείω</span></b> , 
			Ion.
		
		<b><span class="alpheios-lex-greek" lang="grc">ἀποπλᾰν-πλώω</span></b> 
		v. l. in <i><span class="en">
			Hdt.
			4.156
		</span></i>,<i><span class="en">
			157
		</span></i>, cf. <i><span class="en">
			Arr.
			<u>Ind.</u>
			26.9
		</span></i>: fut.
		<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b>
				“<span class="alpheios-lex-greek" lang="grc">-πλεύσομαι</span>”
				 <i><span class="en">
					Hdt.
					4.147
				</span></i>
			; 
				“<span class="alpheios-lex-greek" lang="grc">-πλευσοῦμαι</span>”
				 <i><span class="en">
					Pl.
					<u>Hp.Mi.</u>
					371b
				</span></i>
			:— <i>sail away, sail off,</i>
			
				“<span class="alpheios-lex-greek" lang="grc">οἴκαδ᾽ ἀποπλείειν</span>”
				 <i><span class="en">
					Il.
					9.418
				</span></i>
			, etc.; 
				“<span class="alpheios-lex-greek" lang="grc">ἐπ᾽ Αἰγύπτου</span>”
				 <i><span class="en">
					Hdt.
					1.1
				</span></i>
			, cf. <i><span class="en">
				Ar.
				<u>Ra.</u>
				1480
			</span></i>; 
				“<span class="alpheios-lex-greek" lang="grc">ὀπίσω ἀ.</span>”
				 <i><span class="en">
					Hdt.
					4.156
				</span></i>
			; 
				“<span class="alpheios-lex-greek" lang="grc">ἐκ τῆς Σικελίας ὡς ἐς τὰς Ἀθήνας</span>”
				 <i><span class="en">
					Th.
					6.61
				</span></i>
			; 
				“<span class="alpheios-lex-greek" lang="grc">ἐπ᾽ οἴκου</span>”
				 <i><span class="en">
					Id.
					1.55
				</span></i>
			.</div>
