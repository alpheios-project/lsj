    <div class="alpheios-lex-entry" lemma-id="n84538" body-key=""><b><span class="alpheios-lex-greek" lang="grc">πολλαπλᾰσι-επιμερής</span></b> , <span class="alpheios-lex-greek" lang="grc">ές</span>, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b><i>containing a number a number of times with more than one
				aliquot part over</i> (e. g. <i><span class="en">
				11
			</span></i>/<i><span class="en">
				3
			</span></i>
			=
			<i><span class="en">
				3
			</span></i>
			<i><span class="en">
				2
			</span></i>/<i><span class="en">
				3
			</span></i>), and <b><span class="alpheios-lex-greek" lang="grc">πολλαπλᾰσι-επιμόριος</span></b> , <span class="alpheios-lex-greek" lang="grc">ον</span>,
				<i>containing a number a number of times with one aliquot part
				over</i> (e. g. <i><span class="en">
				10
			</span></i>/<i><span class="en">
				3
			</span></i>
			=
			<i><span class="en">
				3
			</span></i>
			<i><span class="en">
				1
			</span></i>/<i><span class="en">
				3
			</span></i>), <i><span class="en">
				Nicom.
				<u>Ar.</u>
				1.23
			</span></i>.</div>
