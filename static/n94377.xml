    <div class="alpheios-lex-entry" lemma-id="n94377" body-key=""><b><span class="alpheios-lex-greek" lang="grc">σῑτο-δόκος</span></b> , <span class="alpheios-lex-greek" lang="grc">ον</span>,
			<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b><i>receptive of corn</i> or
				<i>bread</i>, <span class="alpheios-lex-greek" lang="grc">πήρα, γαστήρ</span>, <i><span class="en">
				<u>AP</u>
				6.95
			</span></i> (<i><span class="en">
				Antiphil.
			</span></i>), <i><span class="en">
				11.60
			</span></i> (Paul. Sil.); later <b><span class="alpheios-lex-greek" lang="grc">σῑτο-δόχος</span></b>  (q.v.). </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>II.</b>
			Subst.
			<span class="alpheios-lex-greek" lang="grc">σιτοδόκος, ὁ</span>, <i>keeper of corn</i>, <i><span class="en">
				Hp.
				<u>Epid.</u>
				4.25
			</span></i>.</div>
