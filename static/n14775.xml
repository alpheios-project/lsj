<div xmlns:perseus="http://www.perseus.org/meta/perseus.rdfs#" xmlns:dctype="http://purl.org/dc/dcmitype/" xmlns:tufts="http://www.tufts.edu/" xmlns:alph="http://alpheios.net/namespaces/tei" class="alpheios-lex-text_container en">
    <div class="alpheios-lex-entry" lemma-id="n14775" body-key=""><b><span class="alpheios-lex-greek" lang="grc">ἀργήεις</span></b> , <span class="alpheios-lex-greek" lang="grc">εσσα</span>,
			<span class="alpheios-lex-greek" lang="grc">εν</span>: 
			Dor.
		
		<b><span class="alpheios-lex-greek" lang="grc">ἀργάεις</span></b> , 
			contr.
		
		<b><span class="alpheios-lex-greek" lang="grc">ἀργᾶς</span></b> , gen. <span class="alpheios-lex-greek" lang="grc">ᾶντος</span>: (v. <span class="alpheios-lex-greek" lang="grc">ἀργός</span>):—<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b><i>white, shining,</i>
			
				“<span class="alpheios-lex-greek" lang="grc">ταῦρον ἀργᾶντα</span>”
				 <i><span class="en">
					Pi.
					<u>O.</u>
					13.69
				</span></i>
			; <span class="alpheios-lex-greek" lang="grc">ἐν ἀργάεντι</span> (
				v.l.
				<span class="alpheios-lex-greek" lang="grc">ἀργινόεντι</span>
			)
				“<span class="alpheios-lex-greek" lang="grc"> μαστῷ</span>”
				 <i><span class="en">
					Id.
					<u>P.</u>
					4.8
				</span></i>
			; <span class="alpheios-lex-greek" lang="grc">οἰωνός . . ἔξοπιν ἀργᾶς,</span>
			
				=
				<span class="alpheios-lex-greek" lang="grc">πύγαργος</span>
			, prob. in <i><span class="en">
				A.
				<u>Ag.</u>
				115
			</span></i> (lyr.). </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense3"><b>2.</b>
			
				=
				<span class="alpheios-lex-greek" lang="grc">ἀργεστής, ἀργήεσσιν
					ἀέλλαις</span>
			
			<i><span class="en">
				Orph.
				<u>A.</u>
				128
			</span></i>, cf. <i><span class="en">
				685
			</span></i>.</div>
