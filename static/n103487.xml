    <div class="alpheios-lex-entry" lemma-id="n103487" body-key=""><b><span class="alpheios-lex-greek" lang="grc">τετρά̆-πλευρος</span></b> , <span class="alpheios-lex-greek" lang="grc">ον</span>,
			<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b><i>four-sided</i>, 
				“<span class="alpheios-lex-greek" lang="grc">σχῆμα</span>”
				 <i><span class="en">
					Str.
					5.1.2
				</span></i>
			; 
				“<span class="alpheios-lex-greek" lang="grc">κίων</span>”
				 <i><span class="en">
					<u>AP</u>
					9.682
				</span></i>
			; 
				“<span class="alpheios-lex-greek" lang="grc">σῶμα</span>”
				 <i><span class="en">
					Gal.
					8.894
				</span></i>
