    <div class="alpheios-lex-entry" lemma-id="n78558" body-key=""><b><span class="alpheios-lex-greek" lang="grc">παραπέτασμα</span></b> , <span class="alpheios-lex-greek" lang="grc">ατος</span>,
			τό, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b><i>that which is spread before</i> a thing, <i>hanging,
				curtain</i>, 
				“<span class="alpheios-lex-greek" lang="grc">παραπετάσματα ποικίλα</span>”
				 <i><span class="en">
					Hdt.
					9.82
				</span></i>
			 ; 
				“<span class="alpheios-lex-greek" lang="grc">π. Μηδικά</span>”
				 <i><span class="en">
					Ar.
					<u>Ra.</u>
					938
				</span></i>
			 ; 
				“<span class="alpheios-lex-greek" lang="grc">τὸ π. τὸ Κύπριον</span>”
				 <i><span class="en">
					Id.
					<u>Fr.</u>
					611
				</span></i>
			 ; 
				“<span class="alpheios-lex-greek" lang="grc">π. λιτόν</span>”
				 <i><span class="en">
					<u>IG</u>
					12.330.6
				</span></i>
			 : metaph., <i>screen, cover</i>, 
				“<span class="alpheios-lex-greek" lang="grc">ταῖς τέχναις ταύταις παραπετάσμασιν
					ἐχρήσαντο</span>”
				 <i><span class="en">
					Pl.
					<u>Prt.</u>
					316e
				</span></i>
			, cf. <i><span class="en">
				D.
				45.19
			</span></i> ; 
				“<span class="alpheios-lex-greek" lang="grc">τὰ χρήματα . . π. τοῦ βίου</span>”
				 <i><span class="en">
					Alex.
					340
				</span></i>
			 ( =
			<i><span class="en">
				Antiph.
				327
			</span></i>) ; 
				“<span class="alpheios-lex-greek" lang="grc">εἶχεν δὲ π. τὴν ἐρημίαν</span>”
				 <i><span class="en">
					Men.
					406.4
				</span></i>
			. </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>II.</b> pl.,
				<i>mantlets</i>, <i><span class="en">
				Agath.
				3.7
			</span></i>.</div>
