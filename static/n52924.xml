<div xmlns:perseus="http://www.perseus.org/meta/perseus.rdfs#" xmlns:dctype="http://purl.org/dc/dcmitype/" xmlns:tufts="http://www.tufts.edu/" xmlns:alph="http://alpheios.net/namespaces/tei" class="alpheios-lex-text_container en">
    <div class="alpheios-lex-entry" lemma-id="n52924" body-key=""><b><span class="alpheios-lex-greek" lang="grc">κάμαρος</span></b> , ὁ, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b>
				v.
				<span class="alpheios-lex-greek" lang="grc">κάμμαρος</span>
			. </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>II.</b>
			<b><span class="alpheios-lex-greek" lang="grc">καμαρός</span></b> , <span class="alpheios-lex-greek" lang="grc">ά</span>, <span class="alpheios-lex-greek" lang="grc">όν</span>, Carian
			word, 
				=
				<span class="alpheios-lex-greek" lang="grc">ἀσφαλής, κάμαρα</span>
			 (sic codd.) 
				“<span class="alpheios-lex-greek" lang="grc">λέγεσθαι τὰ ἀσφαλῆ</span>”
				 <i><span class="en">
					Apollon.
				</span></i>
			 ap. Sch. 
			<i><span class="en">
				Orib.
				46.21.7
			</span></i>. </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>III.</b>
			<b><span class="alpheios-lex-greek" lang="grc">κάμαροι:</span></b> 
			<span class="alpheios-lex-greek" lang="grc">στῆλαι ἐν αἷς ἀναγέγραπται ὁ
				περιορισμὸς τῆς Ἀσίας</span>, <i><span class="en">
				Hsch.
			</span></i></div>
    </div> <div class="alpheios-lex-footnotes en"> </div>
