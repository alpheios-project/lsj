					Id.
					<u>Ra.</u>
					257
				</span></i>
			 ; 
				“<span class="alpheios-lex-greek" lang="grc">οἰμώξἄρα σύ</span>”
				 <i><span class="en">
					Id.
					<u>Pl.</u>
					876
				</span></i>
			 ; 
				“<span class="alpheios-lex-greek" lang="grc">οἰμώξεσθ᾽ ἄρα</span>”
				 <i><span class="en">
					Id.
					<u>Nu.</u>
					217
				</span></i>
			 ; 
				“<span class="alpheios-lex-greek" lang="grc">οἰμώζειν λέγω σοι</span>”
				 <i><span class="en">
					Id.
					<u>Pl.</u>
					58
				</span></i>
			, cf. <i><span class="en">
				Luc.
				<u>Gall.</u>
				23
			</span></i> ; <span class="alpheios-lex-greek" lang="grc">οὐκ οἰμώξεται</span>; <i><span class="en">
				Ar.
				<u>Ra.</u>
				178
			</span></i>, cf. <i><span class="en">
				X.
				<u>HG</u>
				2.3.56
			</span></i>, <i><span class="en">
				Men.
				<u>Epit.</u>
				428
			</span></i> ; 
				“<span class="alpheios-lex-greek" lang="grc">οἰμώζων καθεδεῖται</span>”
				 <i><span class="en">
					Ar.
					<u>Ach.</u>
					840
				</span></i>
			 ; 
				“<span class="alpheios-lex-greek" lang="grc">οἴμωζε μεγάλα</span>”
