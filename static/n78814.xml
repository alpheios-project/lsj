    <div class="alpheios-lex-entry" lemma-id="n78814" body-key=""><b><span class="alpheios-lex-greek" lang="grc">παραστείχω</span></b> , aor.
		<span class="alpheios-lex-greek" lang="grc">παρέστῐχον</span>, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b><i>go past, pass by</i>, c. acc. loci, <i><span class="en">
				<u>h.Ap.</u>
				217
			</span></i> ; <span class="alpheios-lex-greek" lang="grc">δόμους π</span>. (prob. for
				<span class="alpheios-lex-greek" lang="grc">δόμοις</span>) <i><span class="en">
				A.
				<u>Ch.</u>
				568
			</span></i> : abs., <i>pass by</i>, <i><span class="en">
				S.
				<u>OT</u>
				808
			</span></i> (sed leg. <span class="alpheios-lex-greek" lang="grc">ὄχους</span>), <i><span class="en">
				<u>AP</u>
				9.679
			</span></i>, <i><span class="en">
				<u>Sammelb.</u>
				4312.9
			</span></i> (<span class="entity">Ptolemaic</span>), <i><span class="en">
				<u>Ath.Mitt.</u>
				17.272
			</span></i>
			<span class="entity">(ii A. D.)</span>. </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense3"><b>2.</b>
			<i>transgress</i>, 
				“<span class="alpheios-lex-greek" lang="grc">ἤν τι τούτων ὧν λέγω -στείξῃς</span>”
				 <i><span class="en">
					Herod.
					5.50
				</span></i>
			. </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>II.</b>
			<i>pass into, enter</i>, 
				“<span class="alpheios-lex-greek" lang="grc">δόμους</span>”
				 <i><span class="en">
					S.
					<u>Ant.</u>
					1255
				</span></i>
			.</div>
