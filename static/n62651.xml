    <div class="alpheios-lex-entry" lemma-id="n62651" body-key=""><b><span class="alpheios-lex-greek" lang="grc">λεύκῐνος</span></b> , <span class="alpheios-lex-greek" lang="grc">η</span>,
			<span class="alpheios-lex-greek" lang="grc">ον</span>, (<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b>
				“<span class="alpheios-lex-greek" lang="grc">λεύκη</span>”
				 <i><span class="en">
					11
				</span></i>
			) <i>of white poplar</i>, 
				“<span class="alpheios-lex-greek" lang="grc">στέφανοι</span>”
				 <i><span class="en">
					Arist.
					<u>Oec.</u>
					1353b27
				</span></i>
			; 
				“<span class="alpheios-lex-greek" lang="grc">μύρον</span>”
				 <i><span class="en">
					Gal.
					13.631
				</span></i>
			. </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense3"><b>2.</b> of soldiers,
				<i>decorated with chaplets of white poplar</i>, <i><span class="en">
				<u>OGI</u>
				266.14
			</span></i> (Pergam., <span class="entity">iii B.C.</span>). </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>II.</b> (
				“<span class="alpheios-lex-greek" lang="grc">λευκαία</span>”
				 <i><span class="en">
					1
				</span></i>
			) <i>of hemp</i>, <span class="alpheios-lex-greek" lang="grc">σχοινία</span> Hsch.
				s.v.
				<span class="alpheios-lex-greek" lang="grc">μασχάλην</span>
			.</div>
