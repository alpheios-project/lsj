    <div class="alpheios-lex-entry" lemma-id="n64856" body-key=""><b><span class="alpheios-lex-greek" lang="grc">μαλίρ:</span></b> 
		<span class="alpheios-lex-greek" lang="grc">γῆ Κιμωλία</span>, <i><span class="en">
			Hsch.
		</span></i>
		<b><span class="alpheios-lex-greek" lang="grc">μᾶλις</span></b> , <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b>
				=
				<span class="alpheios-lex-greek" lang="grc">μηλίς</span>
			 (B), <i><span class="en">
				<u>Hippiatr.</u>
				2
			</span></i>. <b><span class="alpheios-lex-greek" lang="grc">Μᾱλίς</span></b> , <span class="alpheios-lex-greek" lang="grc">ίδος</span>, ἡ, 
				Dor.
			 for <span class="alpheios-lex-greek" lang="grc">Μηλίς</span>. <b><span class="alpheios-lex-greek" lang="grc">μάλιστα</span></b> , Adv.
			
				Sup. of
			
			<span class="alpheios-lex-greek" lang="grc">μάλα</span>, 
				v.
				<span class="alpheios-lex-greek" lang="grc">μάλα</span>
			
			<i><span class="en">
				111
			</span></i>. <b><span class="alpheios-lex-greek" lang="grc">μαλιωτέρα:</span></b> 
			<span class="alpheios-lex-greek" lang="grc">προσφιλεστέρα</span>, <i><span class="en">
				Hsch.
			</span></i>; cf. <span class="alpheios-lex-greek" lang="grc">μάλιαν</span>. <b><span class="alpheios-lex-greek" lang="grc">μαλκάω</span></b> , 
				=
				<span class="alpheios-lex-greek" lang="grc">ναρκάω</span>
			, Sch.<i><span class="en">
				Nic.
				<u>Th.</u>
				382
			</span></i>. <b><span class="alpheios-lex-greek" lang="grc">μαλκενίς:</span></b> 
			<span class="alpheios-lex-greek" lang="grc">παρθένος</span> (Cret.), <i><span class="en">
				Hsch.
			</span></i>; cf. <span class="alpheios-lex-greek" lang="grc">μαλακίννης</span>.</div>
