			</span></i> (pl.), <i><span class="en">
				Hdt.
				1.193
			</span></i>, <i><span class="en">
				3.48
			</span></i>, <i><span class="en">
				117
			</span></i>, <i><span class="en">
				Ar.
				<u>V.</u>
				676
			</span></i>(pl.), <i><span class="en">
				Thphr.
				<u>HP</u>
				8.1.1
			</span></i>, <i><span class="en">
				<u>OGI</u>
				55.16
			</span></i> (Telmessus, <span class="entity">iii B.C.</span>), <i><span class="en">
				<u>PCair.Zen.</u>
				787.21
			</span></i>
