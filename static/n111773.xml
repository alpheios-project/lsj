<div xmlns:perseus="http://www.perseus.org/meta/perseus.rdfs#" xmlns:dctype="http://purl.org/dc/dcmitype/" xmlns:tufts="http://www.tufts.edu/" xmlns:alph="http://alpheios.net/namespaces/tei" class="alpheios-lex-text_container en">
    <div class="alpheios-lex-entry" lemma-id="n111773" body-key=""><b><span class="alpheios-lex-greek" lang="grc">φλῆνος</span></b> , <span class="alpheios-lex-greek" lang="grc">εος</span>, τό, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b>
				=
				<span class="alpheios-lex-greek" lang="grc">φλήναφος</span>
			, prob. for <span class="alpheios-lex-greek" lang="grc">φλῆφος</span> in <i><span class="en">
				Hsch.
			</span></i>
		</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>II.</b>
			<b><span class="alpheios-lex-greek" lang="grc">φληνός</span></b>  and <b><span class="alpheios-lex-greek" lang="grc">φλενός</span></b>  are assumed as etym.
			of <span class="alpheios-lex-greek" lang="grc">φλήναφος</span> in <i><span class="en">
				<u>EM</u>
				796.9
			</span></i>, <i><span class="en">
				10
			</span></i>.</div>
    </div> <div class="alpheios-lex-footnotes en"> </div>
