    <div class="alpheios-lex-entry" lemma-id="n69919" body-key=""><b><span class="alpheios-lex-greek" lang="grc">ναύ-φρακτος</span></b> , 
			Att.
		
		<b><span class="alpheios-lex-greek" lang="grc">ναύ-φαρκτος</span></b> 
		<i><span class="en">
			Phot.
		</span></i> (<span class="alpheios-lex-greek" lang="grc">ναύφ</span>[ . . . .]<span class="alpheios-lex-greek" lang="grc">ος</span>
		<i><span class="en">
			<u>IG</u>
			12.296.30
		</span></i>), <span class="alpheios-lex-greek" lang="grc">ον</span>: (<span class="alpheios-lex-greek" lang="grc">φράσσω</span>):—<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b><i>shipfenced,</i>
			<span class="alpheios-lex-greek" lang="grc">Ἰάνων ν. Ἄρης,</span> of the Greeks
			at Salamis, <i><span class="en">
				A.
				<u>Pers.</u>
				951
			</span></i> (lyr.); so <span class="alpheios-lex-greek" lang="grc">ν. ὅμιλος</span>
				ib.<i><span class="en">
				1029
			</span></i> (lyr.); 
				“<span class="alpheios-lex-greek" lang="grc">στράτευμα</span>”
				 <i><span class="en">
					E.
					<u>IA</u>
					1259
				</span></i>
			; 
				“<span class="alpheios-lex-greek" lang="grc">στρατός</span>”
				 <i><span class="en">
					Ar.
					<u>Eq.</u>
					567
				</span></i>
			; <span class="alpheios-lex-greek" lang="grc">ναύφαρκτον βλέπειν</span> to look
				like a <i>ship of war,</i>
			<i><span class="en">
				Id.
				<u>Ach.</u>
				95
			</span></i>.</div>
