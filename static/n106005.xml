<div xmlns:perseus="http://www.perseus.org/meta/perseus.rdfs#" xmlns:dctype="http://purl.org/dc/dcmitype/" xmlns:tufts="http://www.tufts.edu/" xmlns:alph="http://alpheios.net/namespaces/tei" class="alpheios-lex-text_container en">
    <div class="alpheios-lex-entry" lemma-id="n106005" body-key=""><b><span class="alpheios-lex-greek" lang="grc">τῡρό-εις</span></b> , <span class="alpheios-lex-greek" lang="grc">εσσα</span>,
			<span class="alpheios-lex-greek" lang="grc">εν</span>, 
			contr.
		
		<b><span class="alpheios-lex-greek" lang="grc">τῡροῦς</span></b> , <span class="alpheios-lex-greek" lang="grc">οῦσσα</span>, <span class="alpheios-lex-greek" lang="grc">οῦν</span>, 
			Dor.
		
		<b><span class="alpheios-lex-greek" lang="grc">τῡρῶς</span></b> , <span class="alpheios-lex-greek" lang="grc">ῶσσα</span><span class="alpheios-lex-greek" lang="grc">, ῶν: </span>(<span class="alpheios-lex-greek" lang="grc">τυρός</span>):—<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b><i>cheesy, like cheese,</i>
			
				“<span class="alpheios-lex-greek" lang="grc">ἄρτον τυρῶντα</span>”
				 <i><span class="en">
					Sophr.
					14
				</span></i>
			: <span class="alpheios-lex-greek" lang="grc">ὁ τ.</span> (sc. <span class="alpheios-lex-greek" lang="grc">ἄρτος</span> or <span class="alpheios-lex-greek" lang="grc">πλακοῦς</span>) <i>cheese-bread, cheese-cake,</i> or simply
				<i>cheese,</i>
			<i><span class="en">
				Theoc.
				1.58
			</span></i>, <i><span class="en">
				Hegem.
			</span></i> ap. <i><span class="en">
				Ath.
				15.698f
			</span></i>. <span class="alpheios-lex-greek" lang="grc">[τῡρόεντα</span> is trisyll. in <i><span class="en">
				Theoc.
			</span></i> l. c.]</div>
