    <div class="alpheios-lex-entry" lemma-id="n19600" body-key=""><b><span class="alpheios-lex-greek" lang="grc">βάσταχας:</span></b> 
		<span class="alpheios-lex-greek" lang="grc">τοὺς τραχήλους</span> (
			Boeot.
		), and <b><span class="alpheios-lex-greek" lang="grc">βασταχάζει:</span></b> 
		<span class="alpheios-lex-greek" lang="grc">τραχηλίζει,</span>
		<i><span class="en">
			Hsch.
		</span></i> (<span class="alpheios-lex-greek" lang="grc">βαστρ</span>- cod.):—also <b><span class="alpheios-lex-greek" lang="grc">βάστραχες</span></b> , 
			Boeot.
		, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b>
				=
				<span class="alpheios-lex-greek" lang="grc">οἱ τράχηλοι</span>
			, and <b><span class="alpheios-lex-greek" lang="grc">βαστραχαλίσαι</span></b> , 
				=
				<span class="alpheios-lex-greek" lang="grc">τραχηλιάσαι</span>
			, <i><span class="en">
				<u>EM</u>
				191.11
			</span></i>.</div>
