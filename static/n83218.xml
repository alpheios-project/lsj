    <div class="alpheios-lex-entry" lemma-id="n83218" body-key=""><b><span class="alpheios-lex-greek" lang="grc">πῐνόομαι</span></b> , 
			Pass.
		, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b><i>to be dirty</i>, 
				“<span class="alpheios-lex-greek" lang="grc">χιτὼν πεπινωμένος</span>”
				 <i><span class="en">
					Philet.
					17
				</span></i>
			; of Alexander's complexion as painted by Apelles, <i><span class="en">
				Plu.
				<u>Alex.</u>
				4
			</span></i>: metaph. (cf. 
				“<span class="alpheios-lex-greek" lang="grc">πίνος</span>”
				 <i><span class="en">
					2
				</span></i>
			), <i>literae</i>
			<span class="alpheios-lex-greek" lang="grc">πεπινωμέναι</span> or <span class="alpheios-lex-greek" lang="grc">πεπινωμένως</span>
			<i>scriptae, in archaic style</i>, <i><span class="en">
				Cic.
				<u>Att.</u>
				14.7.2
			</span></i>, <i><span class="en">
				15.16
			</span></i>; 
				“<span class="alpheios-lex-greek" lang="grc">ἡ αὐστηρὰ καὶ πεπ. σύνθεσις</span>”
				 <i><span class="en">
					D.H.
					<u>Dem.</u>
					45
				</span></i>
			.</div>
