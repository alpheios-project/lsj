			 ; <span class="alpheios-lex-greek" lang="grc">ἐκ τριῶν δραχμῶν</span> ib.<i><span class="en">
				283
			</span></i> ; 
				“<span class="alpheios-lex-greek" lang="grc">συμφωνήσας ἐκ δηναρίου</span>”
