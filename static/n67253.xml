    <div class="alpheios-lex-entry" lemma-id="n67253" body-key=""><b><span class="alpheios-lex-greek" lang="grc">μετριό-της</span></b> , <span class="alpheios-lex-greek" lang="grc">ητος</span>,
			ἡ, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b><i>moderation</i>, <i><span class="en">
				Th.
				1.38
			</span></i>, <i><span class="en">
				Pl.
				<u>R.</u>
				560d
			</span></i>, <i><span class="en">
				Philyll.
				7
			</span></i>, <i><span class="en">
				Plb.
				1.88.3
			</span></i>; 
				“<span class="alpheios-lex-greek" lang="grc">μ. τέρψιος</span>”
				 <i><span class="en">
					Democr.
					191
				</span></i>
			; 
				“<span class="alpheios-lex-greek" lang="grc">ἡ τῆς φωνῆς μ.</span>”
				 <i><span class="en">
					Isoc.
					15.296
				</span></i>
			; 
				“<span class="alpheios-lex-greek" lang="grc">ἡ τοῦ βίου μ.</span>”
