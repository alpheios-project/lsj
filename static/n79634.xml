				 <i><span class="en">
					Hdt.
					8.80
				</span></i>
			; 
				“<span class="alpheios-lex-greek" lang="grc">π. βία</span>”
				 <i><span class="en">
					S.
					<u>OC</u>
					916
				</span></i>
			; 
				“<span class="alpheios-lex-greek" lang="grc">π. πολιορκίᾳ</span>”
				 <i><span class="en">
					Th.
					1.98
				</span></i>
			; <span class="alpheios-lex-greek" lang="grc">πολιορκοῦντας π.
			ὁμολογίᾳ</span> ib.<i><span class="en">
				29
			</span></i> : abs., <span class="alpheios-lex-greek" lang="grc">π. τινά, π. πόλιν</span>,
