<div xmlns:perseus="http://www.perseus.org/meta/perseus.rdfs#" xmlns:dctype="http://purl.org/dc/dcmitype/" xmlns:tufts="http://www.tufts.edu/" xmlns:alph="http://alpheios.net/namespaces/tei" class="alpheios-lex-text_container en">
    <div class="alpheios-lex-entry" lemma-id="n104561" body-key=""><b><span class="alpheios-lex-greek" lang="grc">τρᾰπεζο-φόρος</span></b> , <span class="alpheios-lex-greek" lang="grc">ον</span>,
			<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b><i>bearing a table</i>:
			</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense3"><b>1.</b>
			<span class="alpheios-lex-greek" lang="grc">τ., ὁ,</span>
			<i>table-bearer,</i>
			<i><span class="en">
				Ar.
				<u>Fr.</u>
				124
			</span></i>. </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense3"><b>2.</b>
			<span class="alpheios-lex-greek" lang="grc">τ., ἡ,</span>
			<i>priestess of Athene</i> at Athens, <i><span class="en">
				Lycurg.
				<u>Fr.</u>
				48
			</span></i>, <i><span class="en">
				Ister
				16
			</span></i>. </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense3"><b>3.</b>
			<span class="alpheios-lex-greek" lang="grc">-φόρον, τό,</span>
			<i>sideboard,</i>
			<i><span class="en">
				Cic.
				<u>Fam.</u>
				7.23.3
			</span></i>, <i><span class="en">
				Poll.
				10.69
			</span></i>, <i><span class="en">
				<u>Dig.</u>
				33.10.3
			</span></i>: also <span class="alpheios-lex-greek" lang="grc">-φόρος, ὁ,</span>
			<i><span class="en">
				Artem.
				1.74
			</span></i>.</div>
    </div> <div class="alpheios-lex-footnotes en"> </div>
