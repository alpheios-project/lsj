				 <i><span class="en">
					Pl.
					<u>R.</u>
					479d
				</span></i>
			:—
				Pass.
			, 
				“<span class="alpheios-lex-greek" lang="grc">προωμολόγηταί τι εἶναι</span>”
				 <i><span class="en">
					Id.
					<u>Phd.</u>
					93d
				</span></i>
			; 
