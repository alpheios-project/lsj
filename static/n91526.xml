    <div class="alpheios-lex-entry" lemma-id="n91526" body-key=""><b><span class="alpheios-lex-greek" lang="grc">πύξῐνος</span></b> , <span class="alpheios-lex-greek" lang="grc">η</span>, <span class="alpheios-lex-greek" lang="grc">ον</span>, (<span class="alpheios-lex-greek" lang="grc">πύξος</span>) <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b><i>made of box-wood</i>, 
				“<span class="alpheios-lex-greek" lang="grc">ζυγόν</span>”
				 <i><span class="en">
					Il.
					24.269
				</span></i>
			; <span class="alpheios-lex-greek" lang="grc">πλαισίω</span> (dual) <i><span class="en">
				<u>IG</u>
				12.373.203
			</span></i>; 
				“<span class="alpheios-lex-greek" lang="grc">κλίνη</span>”
				 <i><span class="en">
					Pl.Com.
					34
				</span></i>
			; 
				“<span class="alpheios-lex-greek" lang="grc">πόδες κλίνης</span>”
				 <i><span class="en">
					<u>PGrenf.</u>
					1.14.7
				</span></i>
			 (<span class="entity">ii B.C.</span>, cf. <i><span class="en">
				2p.211
			</span></i>); 
				“<span class="alpheios-lex-greek" lang="grc">ἁλία</span>”
				 <i><span class="en">
					Archipp.
					13
				</span></i>
			; 
				“<span class="alpheios-lex-greek" lang="grc">φόρμιγξ</span>”
				 <i><span class="en">
					Theoc.
					24.110
				</span></i>
			; 
				“<span class="alpheios-lex-greek" lang="grc">κτένα</span>”
				 <i><span class="en">
					<u>AP</u>
					6.211
				</span></i>
			 (<i><span class="en">
				Leon.
			</span></i>). </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense3"><b>2.</b>
			<span class="alpheios-lex-greek" lang="grc">-ινον, τό</span>,
				<i>box-wood tablet,</i>
			<i><span class="en">
				PGrenf.
				1.14.12
			</span></i> (<span class="entity">ii B.C.</span>, pl.). </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>II.</b>
			<i>yellow as box-wood</i>, <span class="alpheios-lex-greek" lang="grc">Χαιρεφῶν ὁ
			π</span>. <i><span class="en">
				Eup.
				239
			</span></i>, cf. <i><span class="en">
				Philostr.
				<u>VS</u>
				1
			</span></i>
            <u>Praef.</u>, Sch.<i><span class="en">
				Ar.
				<u>V.</u>
				1399
			</span></i>, etc.; <i>pyxinum [collyrium</i>], <i><span class="en">
				Cels.
				6.6.25
			</span></i>.</div>
