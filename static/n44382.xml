					Archestr.
					<u>Fr.</u>
					26
				</span></i>
			: c. gen., 
				“<span class="alpheios-lex-greek" lang="grc">ἱερὸν παντὸς κύματος εὐλίμενον</span>”
				 <i><span class="en">
					<u>App.Anth.</u>
					3.81
				</span></i>
			 (<i><span class="en">
				Posidipp.
			</span></i>): —also<b><span class="alpheios-lex-greek" lang="grc">εὐλῐμήν</span></b> ,-<span class="alpheios-lex-greek" lang="grc">ένος</span>
				“<span class="alpheios-lex-greek" lang="grc">, πορθμοί</span>”
				 <i><span class="en">
					Procop.
					<u>Aed.</u>
					1.5
				</span></i>
			.</div>
