<div xmlns:perseus="http://www.perseus.org/meta/perseus.rdfs#" xmlns:dctype="http://purl.org/dc/dcmitype/" xmlns:tufts="http://www.tufts.edu/" xmlns:alph="http://alpheios.net/namespaces/tei" class="alpheios-lex-text_container en">
    <div class="alpheios-lex-entry" lemma-id="n79971" body-key=""><b><span class="alpheios-lex-greek" lang="grc">παστός</span></b> , <span class="alpheios-lex-greek" lang="grc">ή</span>, <span class="alpheios-lex-greek" lang="grc">όν</span>, (<span class="alpheios-lex-greek" lang="grc">πάσσω</span>) <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b><i>sprinkled with salt, salted</i>,
				<i><span class="en">
				Hp.
				<u>Int.</u>
				41
			</span></i> ; <span class="alpheios-lex-greek" lang="grc">ἰχθύς, ἐχῖνος</span>, <i><span class="en">
				<u>Edict.Diocl.Aeg.</u>
				5.5
			</span></i>,<i><span class="en">
				9
			</span></i>. </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense3"><b>2.</b>
			<span class="alpheios-lex-greek" lang="grc">παστόν, τό</span>, <i>powder</i>, <i><span class="en">
				Hp.
				<u>Loc.Hom.</u>
				13
			</span></i>. </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>II.</b>
			<span class="alpheios-lex-greek" lang="grc">παστά, τά</span>,
			a kind of <i>barley-porridge</i>, <i><span class="en">
				Ael.Dion.
				<u>Fr.</u>
				173
			</span></i> ; mixed of cheese and meal, acc. to <i><span class="en">
				Hsch.
			</span></i></div>
