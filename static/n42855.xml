					Lys.
					<u>Fr.</u>
					1.5
				</span></i>
			 ; 
				“<span class="alpheios-lex-greek" lang="grc">ἐ. διατίθεσθαι</span>”
				 <i><span class="en">
					Pl.
					<u>Smp.</u>
					207b
				</span></i>
			 ; <span class="alpheios-lex-greek" lang="grc">ἐ. ἔχειν τοῦ
			Σωκράτους</span> ib.<i><span class="en">
				222c
			</span></i> ; 
				“<span class="alpheios-lex-greek" lang="grc">τοῦ ποιεῖν τι</span>”
				 <i><span class="en">
					X.
					<u>Cyr.</u>
					3.3.12
				</span></i>
			 : 
				Sup.
			
			
				“<span class="alpheios-lex-greek" lang="grc">-ώτατα, ἔχειν τοῦ ἔργου</span>”
				 <i><span class="en">
					Id.
					<u>Hier.</u>
					1.21
				</span></i>
