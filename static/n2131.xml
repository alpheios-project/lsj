    <div class="alpheios-lex-entry" lemma-id="n2131" body-key=""><b><span class="alpheios-lex-greek" lang="grc">αἴγεος</span></b> , <span class="alpheios-lex-greek" lang="grc">α</span>, <span class="alpheios-lex-greek" lang="grc">ον</span>, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b>
				=
				<span class="alpheios-lex-greek" lang="grc">αἴγειος</span>
			, <i><span class="en">
				Od.
				9.196
			</span></i>; <span class="alpheios-lex-greek" lang="grc">διφθ&lt;&gt;ραι</span>
