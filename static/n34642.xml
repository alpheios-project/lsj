<div xmlns:perseus="http://www.perseus.org/meta/perseus.rdfs#" xmlns:dctype="http://purl.org/dc/dcmitype/" xmlns:tufts="http://www.tufts.edu/" xmlns:alph="http://alpheios.net/namespaces/tei" class="alpheios-lex-text_container en">
    <div class="alpheios-lex-entry" lemma-id="n34642" body-key=""><b><span class="alpheios-lex-greek" lang="grc">ἔμ-φραγμα</span></b> , <span class="alpheios-lex-greek" lang="grc">ατος</span>,
			τό, (<span class="alpheios-lex-greek" lang="grc">ἐμφράσσω</span>)
			<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b><i>barrier, obstacle</i>,
				<i><span class="en">
				Isoc.
				7.40
			</span></i>, <i><span class="en">
				Plu.
				2.745f
			</span></i> (pl.). </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense3"><b>2.</b>
			<i>wooden framework, casing</i>, in pl., <i><span class="en">
				Ph.
				<u>Bel.</u>
				66.47
			</span></i>. </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense3"><b>3.</b> pl.,
				<i>impacted faeces</i>, <i><span class="en">
				Archig.
			</span></i> ap. <i><span class="en">
				Aët.
				6.27
			</span></i>. </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense3"><b>4.</b>
			<i>impaction</i> of foetus, <i><span class="en">
				Hp.
				<u>Oct.</u>
				10
			</span></i>.</div>
    </div> <div class="alpheios-lex-footnotes en"> </div>
