    <div class="alpheios-lex-entry" lemma-id="n93144" body-key=""><b><span class="alpheios-lex-greek" lang="grc">σάλη</span></b> , 
			Dor.
		
		<b><span class="alpheios-lex-greek" lang="grc">σάλα</span></b> , ἡ, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b>
				=
				<span class="alpheios-lex-greek" lang="grc">φροντίς</span>
			 (cf. 
				“<span class="alpheios-lex-greek" lang="grc">σάλος</span>”
				 <i><span class="en">
					11.2
				</span></i>
			), <i><span class="en">
				Hsch.
			</span></i>, <i><span class="en">Phot., <u>EM</u>
				151.47</span></i>: also <b><span class="alpheios-lex-greek" lang="grc">σαλέη</span></b> , <i><span class="en">
				Hsch.
			</span></i>
		</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>II.</b> both <span class="alpheios-lex-greek" lang="grc">σαλέη</span> and <span class="alpheios-lex-greek" lang="grc">σάλη</span>
			
				=
				<span class="alpheios-lex-greek" lang="grc">βλάβη</span>
			, Id. <b><span class="alpheios-lex-greek" lang="grc">σαλητόν</span></b> , 
				v.
				<span class="alpheios-lex-greek" lang="grc">σάρητον</span>
			.</div>
