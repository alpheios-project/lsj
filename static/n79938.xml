    <div class="alpheios-lex-entry" lemma-id="n79938" body-key=""><b><span class="alpheios-lex-greek" lang="grc">πασσᾰλ-εύω</span></b> , 
			Att.
		
		<b><span class="alpheios-lex-greek" lang="grc">παττ-</span></b> , <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b><i>peg, pin</i>, or <i>fasten to</i>, <span class="alpheios-lex-greek" lang="grc">λαβών νιν . . π. πρὸς πέτραις</span> ib.<i><span class="en">
				56
			</span></i> ; 
				“<span class="alpheios-lex-greek" lang="grc">λάφυρα . . δόμοις ἐπασσάλευσαν</span>”
				 <i><span class="en">
					Id.
					<u>Ag.</u>
					579
				</span></i>
			 ; 
				“<span class="alpheios-lex-greek" lang="grc">ὡς πασσαλεύσῃ κρᾶτα τριγλύφοις</span>”
				 <i><span class="en">
					E.
					<u>Ba.</u>
					1214
				</span></i>
			. </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense3"><b>2.</b>
			<i>drive in like a peg</i> or <i>bolt</i>, <span class="alpheios-lex-greek" lang="grc">σφηνὸς . . γνάθον στέρνων διαμπὰξ π</span>. <i><span class="en">
				A.
				<u>Pr.</u>
				65
			</span></i>.</div>
