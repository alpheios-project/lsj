    <div class="alpheios-lex-entry" lemma-id="n95093" body-key=""><b><span class="alpheios-lex-greek" lang="grc">σκολύπτω</span></b> ,= <span class="alpheios-lex-greek" lang="grc">κολούω,
			κολοβόω, ἐκτίλλω</span>, <i><span class="en">
			Hsch.
		</span></i>
		<b><span class="alpheios-lex-greek" lang="grc">σκολύφρα:</span></b> 
		<span class="alpheios-lex-greek" lang="grc">σκυθρωπή, σκληρά, ἐργώδης,
		δυσχερής</span>, Id.; cf. <span class="alpheios-lex-greek" lang="grc">σκολύβρα</span>.
			<b><span class="alpheios-lex-greek" lang="grc">σκομβρίζω</span></b> , <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b>
				=
				<span class="alpheios-lex-greek" lang="grc">γογγύζω</span>
			, Id., <i><span class="en">
				Phot.
			</span></i>; also, 
				=
				<span class="alpheios-lex-greek" lang="grc">ῥαθαπυγίζω</span>
			, <i><span class="en">
				Hsch.
			</span></i></div>
