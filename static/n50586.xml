    <div class="alpheios-lex-entry" lemma-id="n50586" body-key=""><b><span class="alpheios-lex-greek" lang="grc">ἰόεις</span></b>  [<span class="alpheios-lex-greek" lang="grc">ῐ], <span class="alpheios-lex-greek" lang="grc">εσα</span>, <span class="alpheios-lex-greek" lang="grc">εν</span>,
			</span>(<span class="alpheios-lex-greek" lang="grc">ἴον</span>) <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b><i>violet-coloured, dark</i>, 
				“<span class="alpheios-lex-greek" lang="grc">ἰόεντα σίδηρον</span>”
				 <i><span class="en">
					Il.
					23.850
				</span></i>
			, cf. Phoronis <i><span class="en">
				<u>Fr.</u>
				2
			</span></i>, <i><span class="en">
				Q.S.
				6.48
			</span></i>; 
				“<span class="alpheios-lex-greek" lang="grc">ἰόεντα θάλασσαν</span>”
				 <i><span class="en">
					Nic.
					<u>Al.</u>
					171
				</span></i>
			. </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>II.</b>
			<b><span class="alpheios-lex-greek" lang="grc">ἰόεις</span></b> , (<span class="alpheios-lex-greek" lang="grc">ἰός</span> B) <i>poisonous</i>, 
				“<span class="alpheios-lex-greek" lang="grc">ἄκανθαι</span>”
				 <i><span class="en">
					Androm.
				</span></i>
			 ap. <i><span class="en">
				Gal.
				14.38
			</span></i> [who makes <span class="alpheios-lex-greek" lang="grc">ῐ</span> short;
			cf. foreg.<i><span class="en">
				11
			</span></i>].</div>
