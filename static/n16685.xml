<div xmlns:perseus="http://www.perseus.org/meta/perseus.rdfs#" xmlns:dctype="http://purl.org/dc/dcmitype/" xmlns:tufts="http://www.tufts.edu/" xmlns:alph="http://alpheios.net/namespaces/tei" class="alpheios-lex-text_container en">
    <div class="alpheios-lex-entry" lemma-id="n16685" body-key=""><b><span class="alpheios-lex-greek" lang="grc">ἄστρ-ωτος</span></b> , <span class="alpheios-lex-greek" lang="grc">ον</span>,
			<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b><i>without bed</i> or
				<i>bedding,</i>
			
				“<span class="alpheios-lex-greek" lang="grc">εὕδω</span>”
				 <i><span class="en">
					Epich.
					35.14
				</span></i>
			, cf. <i><span class="en">
				Pl.
				<u>Smp.</u>
				203d
			</span></i>, <i><span class="en">
				<u>Plt.</u>
				272a
			</span></i>. </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense3"><b>2.</b>
			<i>uncovered,</i>
			<i><span class="en">
				Id.
				<u>Prt.</u>
				321c
			</span></i>: metaph., <i>bare,</i>
			
				“<span class="alpheios-lex-greek" lang="grc">πέδον</span>”
				 <i><span class="en">
					E.
					<u>HF</u>
					52
				</span></i>
			. </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense3"><b>3.</b> of a horse,
				<i>without trappings,</i>
			<i><span class="en">
				Arr.
				<u>Tact.</u>
				2.3
			</span></i>, <i><span class="en">
				Suid.
			</span></i></div>
    </div> <div class="alpheios-lex-footnotes en"> </div>
