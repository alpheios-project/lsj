<div xmlns:perseus="http://www.perseus.org/meta/perseus.rdfs#" xmlns:dctype="http://purl.org/dc/dcmitype/" xmlns:tufts="http://www.tufts.edu/" xmlns:alph="http://alpheios.net/namespaces/tei" class="alpheios-lex-text_container en">
    <div class="alpheios-lex-entry" lemma-id="n111957" body-key=""><b><span class="alpheios-lex-greek" lang="grc">φοινίκ-ῐνος</span></b> 
		<span class="alpheios-lex-greek" lang="grc">[νῑ]</span>, <span class="alpheios-lex-greek" lang="grc">η</span>, <span class="alpheios-lex-greek" lang="grc">ον</span>, (<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b>
				“<span class="alpheios-lex-greek" lang="grc">φοῖνιξ</span>”
				 <i><span class="en">
					B.
					11
				</span></i>
			) 
				=
				<span class="alpheios-lex-greek" lang="grc">φοινικήϊος</span>
			
			<i><span class="en">
				1
			</span></i>, <i>of the date-palm,</i>
			<span class="alpheios-lex-greek" lang="grc">φ. μύρον</span>
			<i>palm</i>-unguent, <i><span class="en">
				Antiph.
				106.4
			</span></i>; <span class="alpheios-lex-greek" lang="grc">οἶνος ὁ φ.</span>
			<i>palm</i>-wine, <i><span class="en">
				Ephipp.
				24
			</span></i>; without <span class="alpheios-lex-greek" lang="grc">οἶνος,</span>
			<i><span class="en">
				Id.
				8.2
			</span></i>; 
				“<span class="alpheios-lex-greek" lang="grc">φ. καρποί</span>”
				 <i><span class="en">
					<u>PHamb.</u>
					5.11
				</span></i>
			
			<span class="entity">(i A.D.)</span>; <span class="alpheios-lex-greek" lang="grc">φοινικίνη, ἡ,</span> name of a plaster, <i><span class="en">
				Gal.
				13.375
			</span></i>. </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense4"><b>b.</b>
			<i>made of palm-wood,</i>
			<i><span class="en">
				Ath.Mech.
				17.14
			</span></i>. </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>II.</b>
			<span class="alpheios-lex-greek" lang="grc">Φοινίκινος, <span class="alpheios-lex-greek" lang="grc">η</span>,
					<span class="alpheios-lex-greek" lang="grc">ον</span>,</span>
			<i>Phoenician,</i>
			
				“<span class="alpheios-lex-greek" lang="grc">ἡ Φ. νόσος</span>”
				<i>elephantiasis,</i>
				 <i><span class="en">
					Gal.
					19.153
				</span></i>
			.</div>
    </div> <div class="alpheios-lex-footnotes en"> </div>
