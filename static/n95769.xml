			, <i>plumbline</i>, <i><span class="en">
				Hsch.
			</span></i>: cf. 
				“<span class="alpheios-lex-greek" lang="grc">σπάρτος</span>”
				 <i><span class="en">
					11.2
				</span></i>
			.</div>
