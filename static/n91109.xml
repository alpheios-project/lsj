    <div class="alpheios-lex-entry" lemma-id="n91109" body-key=""><b><span class="alpheios-lex-greek" lang="grc">πτέρ-ῐνος</span></b> , <span class="alpheios-lex-greek" lang="grc">η</span>,
			<span class="alpheios-lex-greek" lang="grc">ον</span>, also <span class="alpheios-lex-greek" lang="grc">ος</span>,
			<span class="alpheios-lex-greek" lang="grc">ον</span>, (<span class="alpheios-lex-greek" lang="grc">πτερόν</span>)
			<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b><i>made of feathers</i>,
				<span class="alpheios-lex-greek" lang="grc">κύκλος</span>
			<i>feather</i>-fan, <i><span class="en">
				E.
				<u>Or.</u>
				1429
			</span></i> (lyr.); 
				“<span class="alpheios-lex-greek" lang="grc">ῥιπίς</span>”
				 <i><span class="en">
					<u>AP</u>
					6.306
				</span></i>
			 (<span class="entity">Aristo</span>); 
				“<span class="alpheios-lex-greek" lang="grc">στέφανος</span>”
				 <i><span class="en">
					Plb.
					6.23.12
				</span></i>
			; 
				“<span class="alpheios-lex-greek" lang="grc">ναός</span>”
				 <i><span class="en">
					Str.
					9.3.9
				</span></i>
			, <i><span class="en">
				Eratosth.
				<u>Cat.</u>
				29
			</span></i>, <i><span class="en">
				Porph.
			</span></i> ap. <i><span class="en">
				Stob.
				3.21.26
			</span></i>. </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense3"><b>2.</b>
			<i>feathered, winged</i>, <i><span class="en">
				Ar.
				<u>Av.</u>
				903
			</span></i>.</div>
