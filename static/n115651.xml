    <div class="alpheios-lex-entry" lemma-id="n115651" body-key=""><b><span class="alpheios-lex-greek" lang="grc">ψηφ-ίς</span></b> , <span class="alpheios-lex-greek" lang="grc">ῖδος</span> (cf. Hdn.Gr.<i><span class="en">
			2.186
		</span></i>), ἡ, 
			Dim. of
		
		<span class="alpheios-lex-greek" lang="grc">ψῆφος,</span>
		<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b><i>small pebble,</i>
			<i><span class="en">
				Il.
				21.260
			</span></i>, Lex Solonis ap.Sch.Gen.Il.l.c., <i><span class="en">
				Democr.
				164
			</span></i>, <i><span class="en">
				Luc.
				<u>DMar.</u>
				3.2
			</span></i>. </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense3"><b>2.</b>
			<i>pebble for reckoning,</i>
			<i><span class="en">
				AP
				11.365
			</span></i> (<i><span class="en">
				Agath.
			</span></i>). </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense3"><b>3.</b>
			<i>tessellated work,</i> Chor.<i><span class="en">
				p.86B.
			</span></i>
		</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>II.</b>
			<i>gem</i> or <i>amulet</i> worn in a ring, Long us <i><span class="en">
				4.17
			</span></i>, <i><span class="en">
				Alex.Trall.
				11.1
			</span></i>.</div>
