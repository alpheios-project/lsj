    <div class="alpheios-lex-entry" lemma-id="n110081" body-key=""><b><span class="alpheios-lex-greek" lang="grc">φαίαξ</span></b> , <span class="alpheios-lex-greek" lang="grc">ᾱκος</span>, 
			Ion.
		
		<b><span class="alpheios-lex-greek" lang="grc">φαίηξ</span></b> , <span class="alpheios-lex-greek" lang="grc">ηκος</span>, ὁ, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b><i>Phaeacian,</i>
			<i><span class="en">
				Od.
				5.35
			</span></i>, etc. </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>II.</b> pr. n.
			of an architect, who gave his name to <i>conduits</i> or
				<i>sewers</i> (<b><span class="alpheios-lex-greek" lang="grc">φαίᾱκες</span></b>  or <b><span class="alpheios-lex-greek" lang="grc">φαιᾱκοί</span></b> ), <i><span class="en">
				D.S.
				11.25
			</span></i>.</div>
