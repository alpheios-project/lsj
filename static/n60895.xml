    <div class="alpheios-lex-entry" lemma-id="n60895" body-key=""><b><span class="alpheios-lex-greek" lang="grc">κῠνο-κεφάλιον</span></b>  [<span class="alpheios-lex-greek" lang="grc">ᾰ], τό,</span>
		<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b>
				=
				<span class="alpheios-lex-greek" lang="grc">ἀντίρρινον</span>
			, Sch.<i><span class="en">
				Orib.
				2.744
			</span></i>, Ps.-<i><span class="en">
				Dsc.
				4.130
			</span></i>; 
				=
				<span class="alpheios-lex-greek" lang="grc">ψύλλιον</span>
			, ib.<i><span class="en">
				69
			</span></i>, cf. <i><span class="en">
				<u>PMag.Lond.</u>
				46.198
			</span></i>:—also <b><span class="alpheios-lex-greek" lang="grc">κῠνο-κεφᾰλίδιον</span></b> , ib.<i><span class="en">
				121.602
			</span></i>; but <b><span class="alpheios-lex-greek" lang="grc">κῠνο-κεφάλαιον</span></b> , 
				=
				<span class="alpheios-lex-greek" lang="grc">ἀνεμώνη</span>
			, <i><span class="en">
				Hsch.
			</span></i></div>
