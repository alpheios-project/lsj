				 <i><span class="en">
					Il.
					4.513
				</span></i>
			, 
				“<span class="alpheios-lex-greek" lang="grc">μάρνανται</span>”
				 <i><span class="en">
					E.
					<u>Med.</u>
					249
				</span></i>
			; imper. 
				“<span class="alpheios-lex-greek" lang="grc">μάρναο</span>”
				 <i><span class="en">
					Il.
					15.475
				</span></i>
			; subj.
			
				“<span class="alpheios-lex-greek" lang="grc">μαρνώμεσθα</span>”
				 <i><span class="en">
					Hes.
					<u>Sc.</u>
					110
				</span></i>
			; opt. 
				“<span class="alpheios-lex-greek" lang="grc">μαρναίμεθα</span>”
				 <i><span class="en">
					Od.
					11.513
				</span></i>
			; inf.
			
				“<span class="alpheios-lex-greek" lang="grc">μάρνασθαι</span>”
				 <i><span class="en">
					Il.
					5.33
				</span></i>
			, <i><span class="en">
				E.
				<u>Tr.</u>
				731
			</span></i>; part.
			
				“<span class="alpheios-lex-greek" lang="grc">μαρνάμενος</span>”
				 <i><span class="en">
					Il.
					3.307
				</span></i>
			, <i><span class="en">
				Tyrt.
				12.33
			</span></i>, <i><span class="en">
				E.
				<u>Ph.</u>
				1574
			</span></i> (lyr.): impf.
			
