    <div class="alpheios-lex-entry" lemma-id="n40812" body-key=""><b><span class="alpheios-lex-greek" lang="grc">ἐπι-σημειόομαι</span></b> , <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b>
				=
				<span class="alpheios-lex-greek" lang="grc">ἐπισημαίνομαι</span>
			, <i>distinguish, observe</i>, 
				“<span class="alpheios-lex-greek" lang="grc">τὸ ἀνίσχον ζῴδιον</span>”
				 <i><span class="en">
					S.E.
					<u>M.</u>
					5.68
				</span></i>
			; <span class="alpheios-lex-greek" lang="grc">κρότῳ</span> by applause, <i><span class="en">
				Plu.
				2.235c
			</span></i>(nisi leg.<span class="alpheios-lex-greek" lang="grc">-σημην-</span>).
			</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense3"><b>2.</b>. <i>observe,
			remark</i>, 
				“<span class="alpheios-lex-greek" lang="grc">ὅτι . . </span>”
				 <i><span class="en">
					Asp.
					<u>in EN</u>
					139.6
				</span></i>
			, cf.<i><span class="en">
				Anon.Lond.
				21.21
			</span></i>.</div>
