    <div class="alpheios-lex-entry" lemma-id="n14257" body-key=""><b><span class="alpheios-lex-greek" lang="grc">ἀποφῠγή</span></b> 
		ἡ, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b>
				like
				<span class="alpheios-lex-greek" lang="grc">ἀπόφευξις</span>
			, <i>escape</i> or <i>place of refuge,</i>
			
				“<span class="alpheios-lex-greek" lang="grc">βραχείας τὰς ἀποφυγὰς παρέχειν</span>”
				 <i><span class="en">
					Th.
					8.106
				</span></i>
			; <span class="alpheios-lex-greek" lang="grc">ἀ. κακῶν, λυπῶν,</span>
			<i>escape from</i> ills, griefs, <i><span class="en">
				Pl.
				<u>Phd.</u>
				107d
			</span></i>, <i><span class="en">
				<u>Phlb.</u>
				44c
			</span></i>(pl.). </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense3"><b>2.</b>
			<i>excuse, plea,</i>
			<i><span class="en">
				Aristid.
				2.85J.
			</span></i>; <i>shift, subterfuge,</i>
			<i><span class="en">
				PStrassb.
				40.44
			</span></i><span class="entity">(vi A. D.)</span>.</div>
