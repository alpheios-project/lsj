    <div class="alpheios-lex-entry" lemma-id="n80464" body-key=""><b><span class="alpheios-lex-greek" lang="grc">πελένα: </span></b> 
		<span class="alpheios-lex-greek" lang="grc">ζεῦγος βοῶν</span>, <i><span class="en">
			Hsch.
		</span></i>
