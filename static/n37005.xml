    <div class="alpheios-lex-entry" lemma-id="n37005" body-key=""><b><span class="alpheios-lex-greek" lang="grc">ἐξαῦτις</span></b> , 
			Ep.
		
		Adv.
		<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b><i>once more, anew,</i>
			<i><span class="en">
				Il.
				1.223
			</span></i>, etc., <i><span class="en">
				Archil.
				6
			</span></i>, <i><span class="en">
				<u>PLips.</u>
				27.25
			</span></i>
			<span class="entity">(ii A.D.)</span>. </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>II.</b> of place, <i>back again, backwards,</i>
			<i><span class="en">
				Il.
				16.654
			</span></i>, <i><span class="en">
				A.R.
				3.482
			</span></i>. </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>III.</b>
			
				=
				<span class="alpheios-lex-greek" lang="grc">ἔπειτα</span>
			, <i><span class="en">
				Rhian.
				25
			</span></i>.</div>
