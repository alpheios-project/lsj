<div xmlns:perseus="http://www.perseus.org/meta/perseus.rdfs#" xmlns:dctype="http://purl.org/dc/dcmitype/" xmlns:tufts="http://www.tufts.edu/" xmlns:alph="http://alpheios.net/namespaces/tei" class="alpheios-lex-text_container en">
    <div class="alpheios-lex-entry" lemma-id="n4694" body-key=""><b><span class="alpheios-lex-greek" lang="grc">ἀλτρός:</span></b> 
		<span class="alpheios-lex-greek" lang="grc">μισθός,</span> Id. <b><span class="alpheios-lex-greek" lang="grc">ἄλυγος:</span></b> 
		<span class="alpheios-lex-greek" lang="grc">ἄνευ μάστιγος,</span> Id. <b><span class="alpheios-lex-greek" lang="grc">ἀλύδαινος:</span></b> 
		<span class="alpheios-lex-greek" lang="grc">ὁ κακὸς ἄνεμος,</span>
		<i><span class="en">
			Suid.
		</span></i>
		<b><span class="alpheios-lex-greek" lang="grc">ἀλύδοιμος</span></b> , <span class="alpheios-lex-greek" lang="grc">ον</span>, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b>
				=
				<span class="alpheios-lex-greek" lang="grc">πικρός</span>
			, <i><span class="en">
				Sophr.
				139
			</span></i>. <b><span class="alpheios-lex-greek" lang="grc">ἀλύζα:</span></b> 
			<span class="alpheios-lex-greek" lang="grc">ἄλυπον,</span>
			<i><span class="en">
				Hsch.
			</span></i>
			<b><span class="alpheios-lex-greek" lang="grc">ἀλύζω</span></b> , fut.
			<span class="alpheios-lex-greek" lang="grc">ἀλύξω,</span>
			
				=
				<span class="alpheios-lex-greek" lang="grc">ἀλύω</span>
			, <i><span class="en">
				Gal.
				19.76
			</span></i>. <b><span class="alpheios-lex-greek" lang="grc">ἀλύη</span></b> , ἡ, <i>socket for</i>
			<span class="alpheios-lex-greek" lang="grc">ἐχέτλη,</span> q.v., <i><span class="en">
				Eratosth.
			</span></i> ap. <i><span class="en">
				<u>EM</u>
				173.24
			</span></i>; dub. l. <i><span class="en">
				Phld.
				<u>Mort.</u>
				p.318M.
			</span></i>
			<b><span class="alpheios-lex-greek" lang="grc">ἁλυκᾶτος</span></b> , <span class="alpheios-lex-greek" lang="grc">η</span>, <span class="alpheios-lex-greek" lang="grc">ον</span>,
				<i>pickled,</i>
			
				“<span class="alpheios-lex-greek" lang="grc">κεστρεῖς</span>”
				 <i><span class="en">
					Xenocr.
					149
				</span></i>
			.</div>
