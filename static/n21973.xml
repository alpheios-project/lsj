    <div class="alpheios-lex-entry" lemma-id="n21973" body-key=""><b><span class="alpheios-lex-greek" lang="grc">γεργέρινος</span></b> , <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b>
				=
				<span class="alpheios-lex-greek" lang="grc">γεργῖνος</span>
			, <i><span class="en">
				Hsch.
			</span></i>
			<b><span class="alpheios-lex-greek" lang="grc">γέργερος:</span></b> 
			<span class="alpheios-lex-greek" lang="grc">βρόγχος</span>, Id.; cf. <span class="alpheios-lex-greek" lang="grc">γαργαρεών</span>. <b><span class="alpheios-lex-greek" lang="grc">γεργέροψ:</span></b> 
			<span class="alpheios-lex-greek" lang="grc">ζῷον</span>, Id. (<span class="alpheios-lex-greek" lang="grc">γεργέλ-</span> cod.). <b><span class="alpheios-lex-greek" lang="grc">γεργῖνος</span></b> , ὁ, 
				=
				<span class="alpheios-lex-greek" lang="grc">διάβολος</span>
			, Id. <b><span class="alpheios-lex-greek" lang="grc">γέργυπες:</span></b> 
			<span class="alpheios-lex-greek" lang="grc">νεκροί</span>, Id.</div>
