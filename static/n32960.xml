				 <i><span class="en">
					Chrysipp.Stoic.
					2.146
				</span></i>
			 (codd. <i><span class="en">
				Plu.
			</span></i>, <span class="alpheios-lex-greek" lang="grc">ἑκτικά</span> Arnim).</div>
