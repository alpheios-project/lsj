    <div class="alpheios-lex-entry" lemma-id="n2950" body-key=""><b><span class="alpheios-lex-greek" lang="grc">ἄκαρπ-ος</span></b> , <span class="alpheios-lex-greek" lang="grc">ον</span>,
			<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b><i>without fruit, barren</i>,
				<i><span class="en">
				E.
				<u>Fr.</u>
				898.8
			</span></i>, <i><span class="en">
				Pl.
				<u>Ti.</u>
				91c
			</span></i>; <span class="alpheios-lex-greek" lang="grc">ἄ. ξύλον,</span>
			
				=
				<span class="alpheios-lex-greek" lang="grc">ἀκακία</span>
			, <i><span class="en">
				LXX
				<u>Is.</u>
				41.19
			</span></i>: c. gen., 
				“<span class="alpheios-lex-greek" lang="grc">λίμνη ἄ. ἰχθύων</span>”
