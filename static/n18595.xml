    <div class="alpheios-lex-entry" lemma-id="n18595" body-key=""><b><span class="alpheios-lex-greek" lang="grc">ἄφῡσος</span></b> , <span class="alpheios-lex-greek" lang="grc">ον</span>,
			(<span class="alpheios-lex-greek" lang="grc">φῦσα</span>) <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b><i>without flatulence,</i>
			<i><span class="en">
				Hp.
				<u>Hum.</u>
				3
			</span></i>. </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense3"><b>2.</b>
			<i>causing no flatulence,</i>
			<i><span class="en">
				Diocl.Fr.
				128
			</span></i>, <i><span class="en">
				Gal.
				6.540
			</span></i>. </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense3"><b>3.</b>
			<i>expelling flatus,</i>
			<i><span class="en">
				Ruf.
				<u>Fr.</u>
			</span></i>I, <i><span class="en">
				Gal.
				12.101
			</span></i>.</div>
