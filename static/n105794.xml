<div xmlns:perseus="http://www.perseus.org/meta/perseus.rdfs#" xmlns:dctype="http://purl.org/dc/dcmitype/" xmlns:tufts="http://www.tufts.edu/" xmlns:alph="http://alpheios.net/namespaces/tei" class="alpheios-lex-text_container en">
    <div class="alpheios-lex-entry" lemma-id="n105794" body-key=""><b><span class="alpheios-lex-greek" lang="grc">Τρω-ϊάς</span></b> , 
			contr.
		
		<b><span class="alpheios-lex-greek" lang="grc">Τρῳάς</span></b>  (freq. written <span class="alpheios-lex-greek" lang="grc">Τρωάς</span>), <span class="alpheios-lex-greek" lang="grc">άδος</span>,
		fem. of <span class="alpheios-lex-greek" lang="grc">Τρώϊος,</span>
		<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b><i>Trojan,</i>
			<i><span class="en">
				Od.
				13.263
			</span></i>; 
				“<span class="alpheios-lex-greek" lang="grc">Τρωϊάδας γυναῖκας</span>”
				 <i><span class="en">
					Il.
					9.139
				</span></i>
			, al.; <span class="alpheios-lex-greek" lang="grc">Τρωϊάδες</span> alone,
				<i><span class="en">
				18.122
			</span></i>, al.; <span class="alpheios-lex-greek" lang="grc">Τρῶας καὶ
			Τρῳάδας</span> Trojan men and <i>Trojan women,</i>
			<i><span class="en">
				22.105
			</span></i>. </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>II.</b>
			
				“<span class="alpheios-lex-greek" lang="grc">γῆ Τρῳάς</span>”
				<i>the Troad,</i>
				 <i><span class="en">
					S.
					<u>Aj.</u>
					819
				</span></i>
			, al.; <span class="alpheios-lex-greek" lang="grc">ἡ Τρωάς</span> alone, <i><span class="en">
				Hdt.
				5.122
			</span></i>.</div>
