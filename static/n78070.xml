    <div class="alpheios-lex-entry" lemma-id="n78070" body-key=""><b><span class="alpheios-lex-greek" lang="grc">παραΐσσω</span></b> , 
			Att.
		
		<b><span class="alpheios-lex-greek" lang="grc">παρᾴσσω</span></b> , <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b><i>dart past</i>, <i><span class="en">
				Il.
				5.690
			</span></i>; 
				“<span class="alpheios-lex-greek" lang="grc">παρήϊξεν κοίλας ἐπὶ νῆας</span>”
				 <i><span class="en">
					8.98
				</span></i>
			; 
				“<span class="alpheios-lex-greek" lang="grc">παραΐσσοντος</span>”
				 <i><span class="en">
					20.414
				</span></i>
			; 
