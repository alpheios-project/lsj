    <div class="alpheios-lex-entry" lemma-id="n57779" body-key=""><b><span class="alpheios-lex-greek" lang="grc">κλειστός</span></b> , 
			Ion.
		
		<b><span class="alpheios-lex-greek" lang="grc">κληϊστός</span></b> , old 
			Att.
		
		<b><span class="alpheios-lex-greek" lang="grc">κλῃστός</span></b> , <span class="alpheios-lex-greek" lang="grc">ή</span>, <span class="alpheios-lex-greek" lang="grc">όν</span>, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b><i>that can be shut</i> or <i>closed</i>, 
				“<span class="alpheios-lex-greek" lang="grc">κληϊσταὶ σανίδες</span>”
				 <i><span class="en">
					Od.
					2.344
				</span></i>
			; 
				“<span class="alpheios-lex-greek" lang="grc">χῶμα γαίας κ.</span>”
				 <i><span class="en">
					E.
					<u>Fr.</u>
					617
				</span></i>
			, 
				“<span class="alpheios-lex-greek" lang="grc">βεβαίως κ.</span>”
				 <i><span class="en">
					Th.
					2.17
				</span></i>
			; 
				“<span class="alpheios-lex-greek" lang="grc">κ. λιμήν</span>”
				 <i><span class="en">
					Id.
					7.38
				</span></i>
			; 
				“<span class="alpheios-lex-greek" lang="grc">κ. ἀναβάσεις</span>”
				 <i><span class="en">
					Aen.Tact.
					22.19
				</span></i>
			, cf. <i><span class="en">
				Str.
				14.6.3
			</span></i>, <i><span class="en">
				Scyl.
				29
			</span></i>, al.; 
				“<span class="alpheios-lex-greek" lang="grc">κ. ὕδωρ</span>”
				 <i><span class="en">
					Aristobul.
					35
				</span></i>
			
			<i><span class="en">
				J.
			</span></i>; 
				“<span class="alpheios-lex-greek" lang="grc">θυρίδες κ.</span>”
				 <i><span class="en">
					D.S.
					20.85
				</span></i>
			, cf. <i><span class="en">
				Luc.
				<u>VH</u>
				1.24
			</span></i>, <i><span class="en">
				Philostr.
				<u>Im.</u>
				1.13
			</span></i>. </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense3"><b>2.</b>
			<i>closed</i>, 
				“<span class="alpheios-lex-greek" lang="grc">διώρυγες</span>”
				 <i><span class="en">
					Str.
					15.1.50
				</span></i>
			, al.</div>
