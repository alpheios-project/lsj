    <div class="alpheios-lex-entry" lemma-id="n37942" body-key=""><b><span class="alpheios-lex-greek" lang="grc">ἐπακ-τήρ</span></b> , <span class="alpheios-lex-greek" lang="grc">ῆρος</span>,
			ὁ, 
			Ep.
		 word, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b>
				=
				<span class="alpheios-lex-greek" lang="grc">ὁ κύνας ἐπάγων</span>
			, <i>hunter, huntsman,</i>
			
				“<span class="alpheios-lex-greek" lang="grc">ἐς βῆσσαν ἵκανον ἐπακτῆρες</span>”
				 <i><span class="en">
					Od.
					19.435
				</span></i>
			; 
				“<span class="alpheios-lex-greek" lang="grc">ἄνδρες ἐ.</span>”
				 <i><span class="en">
					Il.
					17.135
				</span></i>
			; later, <i>fisherman,</i>
			<i><span class="en">
				A.R.
				1.625
			</span></i>.</div>
