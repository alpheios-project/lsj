<div xmlns:perseus="http://www.perseus.org/meta/perseus.rdfs#" xmlns:dctype="http://purl.org/dc/dcmitype/" xmlns:tufts="http://www.tufts.edu/" xmlns:alph="http://alpheios.net/namespaces/tei" class="alpheios-lex-text_container en">
    <div class="alpheios-lex-entry" lemma-id="n59819" body-key=""><b><span class="alpheios-lex-greek" lang="grc">κρέμβολα</span></b> , τά, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b><i>bobbins, reels</i>, <i><span class="en">
				Hsch.
			</span></i>
			<b><span class="alpheios-lex-greek" lang="grc">κρέμ&lt;μ&gt;υον</span></b> ,
				τό, 
				=
				<span class="alpheios-lex-greek" lang="grc">κρόμμυον</span>
			, Id. <b><span class="alpheios-lex-greek" lang="grc">κρεμόω</span></b> , 
				Ep.
			
			fut. of <span class="alpheios-lex-greek" lang="grc">κρεμάννυμι</span>.
				<b><span class="alpheios-lex-greek" lang="grc">κρέμυς</span></b> , <span class="alpheios-lex-greek" lang="grc">υος</span>, ἡ, 
				=
				<span class="alpheios-lex-greek" lang="grc">χρέμυς</span>
			, <i><span class="en">
				Arist.
				<u>Fr.</u>
				294
			</span></i>. <b><span class="alpheios-lex-greek" lang="grc">κρεμών</span></b> , 
				=
				<span class="alpheios-lex-greek" lang="grc">ἀκρεμών</span>
			, <i><span class="en">
				Eratosth.
				27
			</span></i>. <b><span class="alpheios-lex-greek" lang="grc">κρέννω</span></b> , Thessal.
			for <span class="alpheios-lex-greek" lang="grc">κρίνω</span> (q.v.).</div>
