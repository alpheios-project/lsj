    <div class="alpheios-lex-entry" lemma-id="n46731" body-key=""><b><span class="alpheios-lex-greek" lang="grc">ἡδύ̆-χροος</span></b> , <span class="alpheios-lex-greek" lang="grc">ον</span>, 
			contr.
		
		<b><span class="alpheios-lex-greek" lang="grc">ἡδύ̆-χρους</span></b> , <span class="alpheios-lex-greek" lang="grc">ουν</span>, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b><i>of sweet complexion</i>, 
				“<span class="alpheios-lex-greek" lang="grc">πρόσωπα</span>”
				 <i><span class="en">
					<u>IG</u>
					14.2040.7
				</span></i>
			; <span class="alpheios-lex-greek" lang="grc">ἡδύχρουν μύρον</span> a
				<i>fragrant</i> perfume, <i><span class="en">
				Dsc.
				1.58
			</span></i>; <span class="alpheios-lex-greek" lang="grc">τὸ ἡ</span>. <i><span class="en">
				Androm.
			</span></i> ap. <i><span class="en">
				Gal.
				14.52
			</span></i>, <i><span class="en">
				Alex.Trall.
				7.3
			</span></i>; <i>hedychrum</i>, <i><span class="en">
				Cic.
				<u>Tusc.</u>
				3.19.46
			</span></i>. </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>II.</b>
			<span class="alpheios-lex-greek" lang="grc">ἡδύχρους</span>, also <span class="alpheios-lex-greek" lang="grc">ἡδύπνους, ὁ</span>, a
			lamb not yet weaned, <i><span class="en">
				Phot.
			</span></i></div>
