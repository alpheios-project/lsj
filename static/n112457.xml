				“<span class="alpheios-lex-greek" lang="grc">φυγαδεύσομαι</span>”
				 <i><span class="en">
					<u>POxy.</u>
					1477.15
				</span></i>
			
			<span class="entity">(iii/iv A. D.)</span>, <i><span class="en">
				Plb.
				10.22.1
			</span></i>.</div>
