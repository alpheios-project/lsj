<div xmlns:perseus="http://www.perseus.org/meta/perseus.rdfs#" xmlns:dctype="http://purl.org/dc/dcmitype/" xmlns:tufts="http://www.tufts.edu/" xmlns:alph="http://alpheios.net/namespaces/tei" class="alpheios-lex-text_container en">
    <div class="alpheios-lex-entry" lemma-id="n20144" body-key=""><b><span class="alpheios-lex-greek" lang="grc">βλιαρόν:</span></b> 
		<span class="alpheios-lex-greek" lang="grc">ἀβλεβές</span>, <i><span class="en">
			Hsch.
		</span></i>: <span class="alpheios-lex-greek" lang="grc">βλιαρόν: λαῦρον</span>, <i><span class="en">
			<u>EM</u>
			201.41
		</span></i>. <b><span class="alpheios-lex-greek" lang="grc">βλιβρόν:</span></b> 
		<span class="alpheios-lex-greek" lang="grc">λαγ&lt;α&gt;ρόν</span>, <i><span class="en">
			Hsch.
		</span></i>
		<b><span class="alpheios-lex-greek" lang="grc">βλίδες:</span></b> 
		<span class="alpheios-lex-greek" lang="grc">ψεκάδες</span>, Id. <b><span class="alpheios-lex-greek" lang="grc">βλίζω</span></b> , <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b>
				=
				<span class="alpheios-lex-greek" lang="grc">βλίττω</span>
			, Id. 
				s.v.
				<span class="alpheios-lex-greek" lang="grc">βλεῖ</span>
			, cf. <i><span class="en">
				<u>EM</u>
				200.33
			</span></i>. <b><span class="alpheios-lex-greek" lang="grc">βλιηχῶδες:</span></b> 
			<span class="alpheios-lex-greek" lang="grc">βλιχανωδες </span>(<span class="alpheios-lex-greek" lang="grc">βλιχῶνες</span> cod.), <i><span class="en">
				Hsch.
			</span></i>
			<b><span class="alpheios-lex-greek" lang="grc">βλίκανος</span></b> , ὁ, 
				=
				<span class="alpheios-lex-greek" lang="grc">βάτραχος</span>
			, <i><span class="en">Hsch.,
					<u>EM</u>201.42</span></i>:—also
				<b><span class="alpheios-lex-greek" lang="grc">βλίχας</span></b> , <i><span class="en">
				Hsch.
			</span></i>: <b><span class="alpheios-lex-greek" lang="grc">βλίκαρος</span></b> , <i><span class="en">
				Suid.
			</span></i>
			<b><span class="alpheios-lex-greek" lang="grc">βλικάς</span></b>  or <b><span class="alpheios-lex-greek" lang="grc">βλίκας</span></b> , <i>fig-leaf</i>,
					<i><span class="en">Hsch.,
					<u>EM</u>201.41</span></i>.</div>
