    <div class="alpheios-lex-entry" lemma-id="n80636" body-key=""><b><span class="alpheios-lex-greek" lang="grc">πεντᾰετ-ής</span></b> , <span class="alpheios-lex-greek" lang="grc">ές</span>, 
			Att.
		
		<b><span class="alpheios-lex-greek" lang="grc">πεντᾰέτης</span></b> , <span class="alpheios-lex-greek" lang="grc">ες</span> (v. <span class="alpheios-lex-greek" lang="grc">διέτης</span>),
		= foreg. I, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b>
				“<span class="alpheios-lex-greek" lang="grc">ἀπὸ πενταέτεος ἀρξάμενοι</span>”
				 <i><span class="en">
					Hdt.
					1.136
				</span></i>
			 ; 
				“<span class="alpheios-lex-greek" lang="grc">πενταετεῖ . . ἤθει ψυχῆς</span>”
				 <i><span class="en">
					Pl.
					<u>Lg.</u>
					793e
				</span></i>
			 :—fem. <b><span class="alpheios-lex-greek" lang="grc">πεντᾰετίς</span></b> , <i><span class="en">
				Plu.
				2.844a
			</span></i>. </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>II.</b>
			<i>lasting five years</i>, 
				“<span class="alpheios-lex-greek" lang="grc">σπονδαί</span>”
				 <i><span class="en">
					Th.
					1.112
				</span></i>
			 codd. ; 
				“<span class="alpheios-lex-greek" lang="grc">χρόνος</span>”
				 <i><span class="en">
					<u>IG</u>
					12(5).860.29
				</span></i>
			 (<span class="entity">Tenos</span>) : neut. as Adv.,
				<span class="alpheios-lex-greek" lang="grc">πεντάετες</span>
			<i>for five years</i>, <i><span class="en">
				Od.
				3.115
			</span></i>.</div>
