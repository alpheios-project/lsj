			 for -<span class="alpheios-lex-greek" lang="grc">σέληνος</span>), <span class="alpheios-lex-greek" lang="grc">ον</span>, <i>moon-lit</i>, 
				“<span class="alpheios-lex-greek" lang="grc">εὐσέλανον δῖον οἶκον</span>”
