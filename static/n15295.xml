				 <i><span class="en">
					Philem.
					4.4
				</span></i>
			. Adv.
			
				“<span class="alpheios-lex-greek" lang="grc">-τῶς</span>”
				 <i><span class="en">
					Plu.
					2.438a
				</span></i>
			.</div>
