<div xmlns:perseus="http://www.perseus.org/meta/perseus.rdfs#" xmlns:dctype="http://purl.org/dc/dcmitype/" xmlns:tufts="http://www.tufts.edu/" xmlns:alph="http://alpheios.net/namespaces/tei" class="alpheios-lex-text_container en">
    <div class="alpheios-lex-entry" lemma-id="n60978" body-key=""><b><span class="alpheios-lex-greek" lang="grc">κῠπᾰρίσσ-ῐνος</span></b> , 
			Att.
		
		<b><span class="alpheios-lex-greek" lang="grc">κῠπᾰρισσ-ίττῐνος</span></b> , <span class="alpheios-lex-greek" lang="grc">η</span>, <span class="alpheios-lex-greek" lang="grc">ον</span>, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b><i>of cypress-wood</i>, 
				“<span class="alpheios-lex-greek" lang="grc">σταθμός</span>”
				 <i><span class="en">
					Od.
					17.340
				</span></i>
			; 
				“<span class="alpheios-lex-greek" lang="grc">μέλαθρον</span>”
				 <i><span class="en">
					Pi.
					<u>P.</u>
					5.39
				</span></i>
			; 
				“<span class="alpheios-lex-greek" lang="grc">λάρνακες</span>”
				 <i><span class="en">
					Th.
					2.34
				</span></i>
			; 
				“<span class="alpheios-lex-greek" lang="grc">μνῆμαι</span>”
				 <i><span class="en">
					Pl.
					<u>Lg.</u>
					741c
				</span></i>
			; 
				“<span class="alpheios-lex-greek" lang="grc">ξυλεία</span>”
				 <i><span class="en">
					Plb.
					10.27.10
				</span></i>
			; also, <i>made</i> or <i>drawn from the cypress</i>, 
				“<span class="alpheios-lex-greek" lang="grc">κ. οἶνος</span>”
				 <i><span class="en">
					Dsc.
					5.36
				</span></i>
			; 
				“<span class="alpheios-lex-greek" lang="grc">ῥητίνη</span>”
				 <i><span class="en">
					Gal.
					13.589
				</span></i>
			.</div>
