<div xmlns:perseus="http://www.perseus.org/meta/perseus.rdfs#" xmlns:dctype="http://purl.org/dc/dcmitype/" xmlns:tufts="http://www.tufts.edu/" xmlns:alph="http://alpheios.net/namespaces/tei" class="alpheios-lex-text_container en">
    <div class="alpheios-lex-entry" lemma-id="n80416" body-key=""><b><span class="alpheios-lex-greek" lang="grc">Πελασγικός</span></b> , <span class="alpheios-lex-greek" lang="grc">ή</span>,
			<span class="alpheios-lex-greek" lang="grc">όν</span>, <u>Pelasgian</u>, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b>
				“<span class="alpheios-lex-greek" lang="grc">Ζεῦ ἄνα Δωδωναῖε, Πελασγικέ</span>”
				 <i><span class="en">
					Il.
					16.233
				</span></i>
			; 
				“<span class="alpheios-lex-greek" lang="grc">τὸ Π. Ἄργος</span>”
				 <i><span class="en">
					2.681
				</span></i>
			, cf. <i><span class="en">
				Hdt.
				1.56
			</span></i>, <i><span class="en">
				Str.
				5.2.4
			</span></i>, <i><span class="en">
				9.5.15
			</span></i> ; =
			<u>Argive</u>, <i><span class="en">
				E.
				<u>Ph.</u>
				107
			</span></i> :—also <b><span class="alpheios-lex-greek" lang="grc">Πελάσγιος</span></b> , <i><span class="en">
				A.
				<u>Supp.</u>
				634
			</span></i> (lyr.), <i><span class="en">
				E.
				<u>IA</u>
				1498
			</span></i> (lyr.) : fem. <b><span class="alpheios-lex-greek" lang="grc">Πελασγίς</span></b> , <span class="alpheios-lex-greek" lang="grc">ίδος</span>, <i><span class="en">
				Hdt.
				7.42
			</span></i>, <i><span class="en">
				A.R.
				4.243
			</span></i> ; <b><span class="alpheios-lex-greek" lang="grc">Πελασγιάς</span></b> ,
				<span class="alpheios-lex-greek" lang="grc">άδος</span>, <i><span class="en">
				Call.
				<u>Lav. Pall.</u>
				4
			</span></i> :—<b><span class="alpheios-lex-greek" lang="grc">Πελασγίη</span></b> , ἡ, 
				=
				<span class="alpheios-lex-greek" lang="grc">Ἑλλάς</span>
			, <i><span class="en">
				Hdt.
				2.56
			</span></i> ; cf. 
				“<span class="alpheios-lex-greek" lang="grc">πελαργικός</span>”
				 <i><span class="en">
					11
				</span></i>
			.</div>
