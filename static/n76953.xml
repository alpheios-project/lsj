    <div class="alpheios-lex-entry" lemma-id="n76953" body-key=""><b><span class="alpheios-lex-greek" lang="grc">πᾰλίν-σκῐος</span></b> , <span class="alpheios-lex-greek" lang="grc">ον</span>,
			<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b><i>shaded over again,
				thick-shaded</i>, 
				“<span class="alpheios-lex-greek" lang="grc">ἐν -σκίῳ</span>”
				 <i><span class="en">
					Archil.
					34
				</span></i>
			, <i><span class="en">
				Plu.
				<u>Num.</u>
				10
			</span></i>, cf. <i><span class="en">
				Is.
				<u>Fr.</u>
				112
			</span></i>; 
				“<span class="alpheios-lex-greek" lang="grc">π. ἐλαῖαι</span>”
				 <i><span class="en">
					Arist.
					<u>HA</u>
					556a24
				</span></i>
			; 
				“<span class="alpheios-lex-greek" lang="grc">ὗλαι</span>”
				 <i><span class="en">
					Luc.
					<u>Am.</u>
					12
				</span></i>
			; <i>dark</i>, 
				“<span class="alpheios-lex-greek" lang="grc">χειμών</span>”
				 <i><span class="en">
					S.
					<u>Fr.</u>
					289
				</span></i>
			:—also <b><span class="alpheios-lex-greek" lang="grc">πᾰλίσκῐος</span></b> , <span class="alpheios-lex-greek" lang="grc">ον</span>
				“<span class="alpheios-lex-greek" lang="grc">, ἄντρον</span>”
				 <i><span class="en">
					<u>h.Merc.</u>
					6
				</span></i>
			, <i><span class="en">
				<u>h.Hom.</u>
				18.6
			</span></i>; 
				“<span class="alpheios-lex-greek" lang="grc">ἐν -σκίοις</span>”
				 <i><span class="en">
					Thphr.
					<u>HP</u>
					1.8.1
				</span></i>
			, cf. <i><span class="en">
				<u>Od.</u>
				40
			</span></i>; 
				“<span class="alpheios-lex-greek" lang="grc">εἰς τὸ π.</span>”
				 <i><span class="en">
					Max.Tyr.
					5.1
				</span></i>
			.</div>
