				Epicur.
				<u>Sent.Vat.</u>
				29
			</span></i>: 
				Sup.
			, 
				“<span class="alpheios-lex-greek" lang="grc">ἀνὴρ -ώτατος τῶν παλαιῶν</span>”
				 <i><span class="en">
					Phld.
					<u>Mus.</u>
					p.108K.
				</span></i>
			
			Adv.
			
				“<span class="alpheios-lex-greek" lang="grc">-γως</span>”
				 <i><span class="en">
					M.Ant.
					10.31
				</span></i>
			.</div>
