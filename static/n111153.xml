    <div class="alpheios-lex-entry" lemma-id="n111153" body-key=""><b><span class="alpheios-lex-greek" lang="grc">φῐλοζω-έω</span></b> , <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b>
				=
				<span class="alpheios-lex-greek" lang="grc">φιλοψυχέω</span>
