    <div class="alpheios-lex-entry" lemma-id="n104462" body-key=""><b><span class="alpheios-lex-greek" lang="grc">τράγ-ειος</span></b>  [<span class="alpheios-lex-greek" lang="grc">ᾰ], <span class="alpheios-lex-greek" lang="grc">α</span>, <span class="alpheios-lex-greek" lang="grc">ον</span>,</span>
