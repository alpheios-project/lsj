<div xmlns:perseus="http://www.perseus.org/meta/perseus.rdfs#" xmlns:dctype="http://purl.org/dc/dcmitype/" xmlns:tufts="http://www.tufts.edu/" xmlns:alph="http://alpheios.net/namespaces/tei" class="alpheios-lex-text_container en">
    <div class="alpheios-lex-entry" lemma-id="n63112" body-key=""><b><span class="alpheios-lex-greek" lang="grc">λιδρίον:</span></b> 
		<span class="alpheios-lex-greek" lang="grc">τρύβλιον</span>, <i><span class="en">
			Hsch.
		</span></i>
		<b><span class="alpheios-lex-greek" lang="grc">λίζει:</span></b> 
		<span class="alpheios-lex-greek" lang="grc">παίζει</span>, and <b><span class="alpheios-lex-greek" lang="grc">λίζουσι:</span></b> 
		<span class="alpheios-lex-greek" lang="grc">παίζουσιν</span>, Id. <b><span class="alpheios-lex-greek" lang="grc">λιζόν:</span></b> 
		<span class="alpheios-lex-greek" lang="grc">ἔλαττον</span>, Id. (i.e. <span class="alpheios-lex-greek" lang="grc">ὄλιζον</span>). <b><span class="alpheios-lex-greek" lang="grc">λίζω</span></b> , <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b><i>graze</i>,
				<i><span class="en">
				Eust.
				1926.37
			</span></i>, as giving the Root of <span class="alpheios-lex-greek" lang="grc">λίγδην,
				ἐπιλίγδην</span>. <b><span class="alpheios-lex-greek" lang="grc">λιζῶνες:</span></b> 
			<span class="alpheios-lex-greek" lang="grc">ἐλάττονες</span>, <i><span class="en">
				Hsch.
			</span></i> (Cf. <span class="alpheios-lex-greek" lang="grc">ὀλείζων, ὀλίγος</span>).
				<b><span class="alpheios-lex-greek" lang="grc">λίημος:</span></b> 
			<span class="alpheios-lex-greek" lang="grc">ψάμαθος</span>, Id. (fort. <span class="alpheios-lex-greek" lang="grc">ἄμμος</span>). <b><span class="alpheios-lex-greek" lang="grc">λίην</span></b> , 
				Ion.
			 and 
				Ep.
			 for <span class="alpheios-lex-greek" lang="grc">λίαν</span>. <b><span class="alpheios-lex-greek" lang="grc">λίηνος:</span></b> 
			<span class="alpheios-lex-greek" lang="grc">λιθοπυργία</span>, Id. <b><span class="alpheios-lex-greek" lang="grc">λίηφος:</span></b> , <span class="alpheios-lex-greek" lang="grc">δεινός</span>, Id. <b><span class="alpheios-lex-greek" lang="grc">λῖθ᾽</span></b> , 
				v.
				<span class="alpheios-lex-greek" lang="grc">λῖτα</span>
			.</div>
