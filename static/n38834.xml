<div xmlns:perseus="http://www.perseus.org/meta/perseus.rdfs#" xmlns:dctype="http://purl.org/dc/dcmitype/" xmlns:tufts="http://www.tufts.edu/" xmlns:alph="http://alpheios.net/namespaces/tei" class="alpheios-lex-text_container en">
    <div class="alpheios-lex-entry" lemma-id="n38834" body-key=""><b><span class="alpheios-lex-greek" lang="grc">ἐπήρᾰτος</span></b> , <span class="alpheios-lex-greek" lang="grc">ον</span>,
			(<span class="alpheios-lex-greek" lang="grc">ἔραμαι</span>) <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b><i>lovely, delightsome,</i>
			
				“<span class="alpheios-lex-greek" lang="grc">δαίς</span>”
				 <i><span class="en">
					Il.
					9.228
				</span></i>
			; 
				“<span class="alpheios-lex-greek" lang="grc">εἵματα</span>”
				 <i><span class="en">
					Od.
					8.366
				</span></i>
			; freq. of places, [
				“<span class="alpheios-lex-greek" lang="grc">Ἰθάκη] μᾶλλον ἐ. ἱπποβότοιο</span>”
				 <i><span class="en">
					4.606
				</span></i>
			; 
				“<span class="alpheios-lex-greek" lang="grc">νῆσος</span>”
				 <i><span class="en">
					Hes.
					<u>Fr.</u>
					76.4
				</span></i>
			; also 
				“<span class="alpheios-lex-greek" lang="grc">καλὸν εἶδος ἐπήρατον</span>”
				 <i><span class="en">
					Id.
					<u>Op.</u>
					63
				</span></i>
			; 
				“<span class="alpheios-lex-greek" lang="grc">ἐπήρατον ὄσσαν ἱεῖσαι</span>”
				 <i><span class="en">
					Id.
					<u>Th.</u>
					67
				</span></i>
			; 
				“<span class="alpheios-lex-greek" lang="grc">ἐπήρατον ἴαχον ὄρθιον</span>”
				 <i><span class="en">
					Sapph.
					<u>Supp.</u>
					20c
				</span></i>
			.<i><span class="en">
				4
			</span></i>; 
				“<span class="alpheios-lex-greek" lang="grc">κῦδος</span>”
				 <i><span class="en">
					Alc.
					<u>Supp.</u>
					23.13
				</span></i>
			; later of persons, 
				“<span class="alpheios-lex-greek" lang="grc">ἐ. ϝεάνιδες</span>”
				 <i><span class="en">
					A.
					<u>Eu.</u>
					958
				</span></i>
			 (lyr.); 
				“<span class="alpheios-lex-greek" lang="grc">παρθενική</span>”
				 <i><span class="en">
					A.R.
					3.1099
				</span></i>
			.</div>
