    <div class="alpheios-lex-entry" lemma-id="n66210" body-key=""><b><span class="alpheios-lex-greek" lang="grc">μεμαίκυλον</span></b> , <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b>
				v.
				<span class="alpheios-lex-greek" lang="grc">μιμαίκυλον</span>
			. <b><span class="alpheios-lex-greek" lang="grc">μεμαῖνα:</span></b> 
			<span class="alpheios-lex-greek" lang="grc">ἀληλλιμένα</span>, <i><span class="en">
				Hsch.
			</span></i>
			<b><span class="alpheios-lex-greek" lang="grc">μεμακυῖα</span></b> , 
				v.
				<span class="alpheios-lex-greek" lang="grc">μηκάομαι</span>
			. <b><span class="alpheios-lex-greek" lang="grc">μεμαλισμένους:</span></b> 
			<span class="alpheios-lex-greek" lang="grc">μεμαλαγμένους, ἢ παραφρονοῦντας,
				μαινομένους</span>, Id. <b><span class="alpheios-lex-greek" lang="grc">μεμάποιεν</span></b> , <b><span class="alpheios-lex-greek" lang="grc">μέμαρπον</span></b> , 
				v.
				<span class="alpheios-lex-greek" lang="grc">μάρπτω</span>
			. <b><span class="alpheios-lex-greek" lang="grc">μεμβλάσαι:</span></b> 
			<span class="alpheios-lex-greek" lang="grc">συνδῆσαι</span>, Id. <b><span class="alpheios-lex-greek" lang="grc">μέμβλεται</span></b> , <b><span class="alpheios-lex-greek" lang="grc">μέμβλετο</span></b> , 
				v.
				<span class="alpheios-lex-greek" lang="grc">μέλω</span>
			. <b><span class="alpheios-lex-greek" lang="grc">μέμβλωκα</span></b> , 
				v.
				<span class="alpheios-lex-greek" lang="grc">βλώσκω</span>
			. <b><span class="alpheios-lex-greek" lang="grc">μεμβλώντων:</span></b> 
			<span class="alpheios-lex-greek" lang="grc">τυχόντων</span>, Id.</div>
