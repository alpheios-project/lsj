        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>II.</b>
			<i>burnt-up remains,</i>
			
				“<span class="alpheios-lex-greek" lang="grc">ἀστέρος</span>”
				 <i><span class="en">
					<u>Placit.</u>
					3.1.2
				</span></i>
			.</div>
