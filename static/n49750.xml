<div xmlns:perseus="http://www.perseus.org/meta/perseus.rdfs#" xmlns:dctype="http://purl.org/dc/dcmitype/" xmlns:tufts="http://www.tufts.edu/" xmlns:alph="http://alpheios.net/namespaces/tei" class="alpheios-lex-text_container en">
    <div class="alpheios-lex-entry" lemma-id="n49750" body-key=""><b><span class="alpheios-lex-greek" lang="grc">ἰατρ-εύω</span></b> , 
			Ion.
		
		pf.
		<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b>
				“<span class="alpheios-lex-greek" lang="grc">ἰήτρευκα</span>”
				 <i><span class="en">
					Hp.
					<u>Art.</u>
					46
				</span></i>
			: (<span class="alpheios-lex-greek" lang="grc">ἰατρός</span>):—<i>treat
				medically, cure</i>, 
				“<span class="alpheios-lex-greek" lang="grc">ἕκαστα</span>”
				 <i><span class="en">
					Id.
					<u>Acut.</u>
					2
				</span></i>
			; 
				“<span class="alpheios-lex-greek" lang="grc">οὐδὲν ἰ. τῆς λύπης</span>”
				 <i><span class="en">
					Phld.
					<u>Mus.</u>
					p.69K.
				</span></i>
			; <span class="alpheios-lex-greek" lang="grc">τινα</span>
			<i><span class="en">
				Hp.
				<u>Art.</u>
			</span></i> l.c., <i><span class="en">
				Pl.
				<u>Lg.</u>
				857d
			</span></i>, al.:— 
				Pass.
			, <i>to be under medical care</i>, <i><span class="en">
				Id.
				<u>R.</u>
				357c
			</span></i>, <i><span class="en">
				<u>Grg.</u>
				478b
			</span></i>sq., al.; <i>to be cured,</i>
			<i><span class="en">
				IG
				14.2283
			</span></i> (<span class="entity">Bononia</span>). </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense3"><b>2.</b> abs., <i>practise medicine</i>, <i><span class="en">
				Hp.
				<u>Art.</u>
				72
			</span></i>; <span class="alpheios-lex-greek" lang="grc">τίς ὀρθῶς ἰάτρευκεν</span>;
				<i><span class="en">
				Arist.
				<u>Pol.</u>
				1281b40
			</span></i>. </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>II.</b> metaph.,
				<i>remedy, correct</i>, <i><span class="en">
				Id.
				<u>PA</u>
				665a8
			</span></i>.</div>
