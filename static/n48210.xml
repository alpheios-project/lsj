    <div class="alpheios-lex-entry" lemma-id="n48210" body-key=""><b><span class="alpheios-lex-greek" lang="grc">θεόληπτ-ος</span></b> , <span class="alpheios-lex-greek" lang="grc">ον</span>,
			<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b><i>possessed, inspired</i>,
				<i><span class="en">
				Arist.
				<u>EE</u>
				1214a23
			</span></i>, <i><span class="en">
				S.E.
				<u>P.</u>
				2.52
			</span></i>, <i><span class="en">
				<u>Cat.Cod.Astr.</u>
				8(4).148
			</span></i>; 
