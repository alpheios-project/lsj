				 <i><span class="en">
					<u>Ep.Heb.</u>
					10.23
				</span></i>
			; 
				“<span class="alpheios-lex-greek" lang="grc">ψυχή</span>”
				 <i><span class="en">
					Luc.
					<u>Dem.Enc.</u>
					33
				</span></i>
			; <i>unmoved, tranquil</i>, <i><span class="en">
				Nonn.
				<u>D.</u>
