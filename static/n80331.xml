<div xmlns:perseus="http://www.perseus.org/meta/perseus.rdfs#" xmlns:dctype="http://purl.org/dc/dcmitype/" xmlns:tufts="http://www.tufts.edu/" xmlns:alph="http://alpheios.net/namespaces/tei" class="alpheios-lex-text_container en">
    <div class="alpheios-lex-entry" lemma-id="n80331" body-key=""><b><span class="alpheios-lex-greek" lang="grc">πεῖνα</span></b> , 
			Ion.
		
		<b><span class="alpheios-lex-greek" lang="grc">πείνη</span></b> , <span class="alpheios-lex-greek" lang="grc">ης</span>, ἡ, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b><i>hunger, famine</i>, 
				“<span class="alpheios-lex-greek" lang="grc">πείνη δ᾽ οὔ ποτε δῆμον ἐπέρχεται</span>”
				 <i><span class="en">
					Od.
					15.407
				</span></i>
			 ; <span class="alpheios-lex-greek" lang="grc">πεῖνα</span> (
				v.l.
				<span class="alpheios-lex-greek" lang="grc">πείνη</span>
			 )
				“<span class="alpheios-lex-greek" lang="grc"> καὶ δίψα</span>”
				 <i><span class="en">
					Pl.
					<u>R.</u>
					585a
				</span></i>
			 ; <span class="alpheios-lex-greek" lang="grc">δίψαν . . καὶ πεῖναν</span>
				ib.<i><span class="en">
				437d
			</span></i> ; 
				“<span class="alpheios-lex-greek" lang="grc">δίψα καὶ πεῖνα</span>”
				 <i><span class="en">
					Arist.
					<u>de An.</u>
					414b11
				</span></i>
			 ; 
				“<span class="alpheios-lex-greek" lang="grc">πείνην τε καὶ δίψος</span>”
				 <i><span class="en">
					Pl.
					<u>Phlb.</u>
					34d
				</span></i>
			 ; <span class="alpheios-lex-greek" lang="grc">πείνη</span> ib. <i><span class="en">
				31e
			</span></i>, <i><span class="en">
				<u>Ly.</u>
				221a
			</span></i> : pl., 
				“<span class="alpheios-lex-greek" lang="grc">δίψαι καὶ πεῖναι</span>”
				 <i><span class="en">
					Arist.
					<u>Rh.</u>
					1389a9
				</span></i>
			. </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense3"><b>2.</b> metaph.,
				<i>hunger</i> or <i>longing for</i> a thing, 
				“<span class="alpheios-lex-greek" lang="grc">διὰ μαθημάτων πείνην</span>”
				 <i><span class="en">
					Pl.
					<u>Phlb.</u>
					52a
				</span></i>
			. (In nom. and acc. sg. <i><span class="en">
				Pl.
			</span></i> usu. has <span class="alpheios-lex-greek" lang="grc">πείνη -ην</span>,
				v. supr.)</div>
