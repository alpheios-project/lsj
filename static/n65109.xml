    <div class="alpheios-lex-entry" lemma-id="n65109" body-key=""><b><span class="alpheios-lex-greek" lang="grc">μάσθλ-ης</span></b> , <span class="alpheios-lex-greek" lang="grc">ητος</span>,
			ὁ, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b>
				=
				<span class="alpheios-lex-greek" lang="grc">ἱμάσθλη</span>
			, <i>leather</i>, <i><span class="en">
				Hp.
				<u>Morb.</u>
				2.59
			</span></i>; 
				Aeol.
			<b><span class="alpheios-lex-greek" lang="grc">μάσλης</span></b> , perh.
				<i>leather shoe</i>, <i><span class="en">
				Sapph.
				19
			</span></i>; <i>thong</i> of a whip, 
				“<span class="alpheios-lex-greek" lang="grc">φοίνιον μάσθλητα δίγονον</span>”
				 <i><span class="en">
					S.
					<u>Fr.</u>
					129
				</span></i>
			: <b><span class="alpheios-lex-greek" lang="grc">μάσθλη</span></b>  is dub., cf.
				ib.<i><span class="en">
				571
			</span></i>, <i><span class="en">
				Hsch.
			</span></i>
		</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>II.</b> metaph., <i>supple,
				slippery knave</i>, <i><span class="en">
				Ar.
				<u>Eq.</u>
				269
			</span></i>, <i><span class="en">
				<u>Nu.</u>
				449
			</span></i> (anap.), <i><span class="en">
				Aristid.
				<u>Or.</u>
				34(50).61
			</span></i>.</div>
