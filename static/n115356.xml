    <div class="alpheios-lex-entry" lemma-id="n115356" body-key=""><b><span class="alpheios-lex-greek" lang="grc">ψάρ</span></b> , ὁ, gen. <span class="alpheios-lex-greek" lang="grc">ψᾱρός</span>: pl. <span class="alpheios-lex-greek" lang="grc">ψᾶρες</span>: 
			Ion.
		
		<b><span class="alpheios-lex-greek" lang="grc">ψήρ</span></b> , <span class="alpheios-lex-greek" lang="grc">ψηρός, ψῆρες</span>:—<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b><i>starling, Sturnus vulgaris,</i>
			
				“<span class="alpheios-lex-greek" lang="grc">ὥς τε ψαρῶν νέφος . . ἠὲ κολοιῶν</span>”
				 <i><span class="en">
					Il.
					17.755
				</span></i>
			; 
				“<span class="alpheios-lex-greek" lang="grc">ἴρηκι ἐοικὼς ὠκέϊ, ὅς τ᾽ ἐφόβησε
					κολοιούς τε ψῆράς τε</span>”
				 <i><span class="en">
					16.583
				</span></i>
			; <span class="alpheios-lex-greek" lang="grc">ψῆρες,</span> dat. <span class="alpheios-lex-greek" lang="grc">ψήρεσι,</span>
			<i><span class="en">
				Q.S.
				8.387
			</span></i>, <i><span class="en">
				11.218
			</span></i>; 
				“<span class="alpheios-lex-greek" lang="grc">ψᾶρες</span>”
				 <i><span class="en">
					Antiph.
					302
				</span></i>
			 (anap.), <i><span class="en">
				<u>AP</u>
				9.373
			</span></i>, <i><span class="en">
				Gal.
				6.567
			</span></i>; <i><span class="en">
				Plu.
				2.972f
			</span></i> mentions their being taught to speak, cf. <i><span class="en">
				Gell.
				13.21
			</span></i> (<i><span class="en">
				20
			</span></i>).<i><span class="en">
				25
			</span></i>.</div>
