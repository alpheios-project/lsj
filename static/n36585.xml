    <div class="alpheios-lex-entry" lemma-id="n36585" body-key=""><b><span class="alpheios-lex-greek" lang="grc">ἔξαιτος</span></b> , <span class="alpheios-lex-greek" lang="grc">ον</span>,
			(<span class="alpheios-lex-greek" lang="grc">ἐξαίνυμαι</span>) <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b><i>picked, choice, excellent,</i>
			
				“<span class="alpheios-lex-greek" lang="grc">οἶνόν τ᾽ ἔ. μελιηδέα</span>”
				 <i><span class="en">
					Il.
					12.320
				</span></i>
			; 
				“<span class="alpheios-lex-greek" lang="grc">νῆα καὶ ἐ. ἐρέτας</span>”
				 <i><span class="en">
					Od.
					2.307
				</span></i>
			; 
				“<span class="alpheios-lex-greek" lang="grc">ἐ. ἑκατόμβας</span>”
				 <i><span class="en">
					5.102
				</span></i>
			: in later Poets 
				like
				<span class="alpheios-lex-greek" lang="grc">ἐξαίρετος</span>
			, <i><span class="en">
				A.R.
				4.1004
			</span></i>, <i><span class="en">
				<u>AP</u>
				6.332.5
			</span></i> (<i><span class="en">
				Hadr.
			</span></i>), <i><span class="en">
				Man.
				2.226
			</span></i>, <i><span class="en">
				3.354
			</span></i>, <i><span class="en">
				<u>Mus.Belg.</u>
				16.71
			</span></i> (Attica, <span class="entity">ii A. D.</span>).</div>
