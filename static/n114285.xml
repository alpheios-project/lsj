    <div class="alpheios-lex-entry" lemma-id="n114285" body-key=""><b><span class="alpheios-lex-greek" lang="grc">χοίρ-ειος</span></b> , <span class="alpheios-lex-greek" lang="grc">α</span>,
			<span class="alpheios-lex-greek" lang="grc">ον</span>, 
			Ep.
		
		<b><span class="alpheios-lex-greek" lang="grc">χοίρεος</span></b> , <span class="alpheios-lex-greek" lang="grc">η</span>, <span class="alpheios-lex-greek" lang="grc">ον</span>:—<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b><i>of a swine,</i>
			
				“<span class="alpheios-lex-greek" lang="grc">κρέα χοίρεια</span>”
				 <i><span class="en">
					Ar.
					<u>Ra.</u>
					338
				</span></i>
			, <i><span class="en">
				X.
				<u>An.</u>
				4.5.31
			</span></i>; 
				“<span class="alpheios-lex-greek" lang="grc">κόπρος</span>”
				 <i><span class="en">
					Arist.
					<u>Fr.</u>
					277
				</span></i>
			; <span class="alpheios-lex-greek" lang="grc">κόπρον χυρίαν</span> (sic) <i><span class="en">
				<u>PHolm.</u>
				25.16
			</span></i>. </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>II.</b>
			<span class="alpheios-lex-greek" lang="grc">χοίρεα</span> (sc. <span class="alpheios-lex-greek" lang="grc">κρέα</span>) <i>pig's</i>-flesh, <i><span class="en">
				Od.
				14.81
			</span></i>; 
				“<span class="alpheios-lex-greek" lang="grc">χοίρειον φαγεῖν</span>”
				 <i><span class="en">
					S.E.
					<u>P.</u>
					3.223
				</span></i>
			, cf. <i><span class="en">
				Hp.
				<u>Epid.</u>
				6.4.4
			</span></i>.</div>
