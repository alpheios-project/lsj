					Pl.
					<u>R.</u>
					612a
				</span></i>
			; 
				“<span class="alpheios-lex-greek" lang="grc">ἐν τοῖς τραχέσι καὶ πετρώδεσι</span>”
				 <i><span class="en">
					Arist.
					<u>HA</u>
					549b14
				</span></i>
			; <span class="alpheios-lex-greek" lang="grc">τὸ π</span>. <i><span class="en">
				<u>BMus.Inscr.</u>
				3.407.8
			</span></i> (<span class="entity">Priene</span>); 
				“<span class="alpheios-lex-greek" lang="grc">ἄνθρωποι π. καὶ δενδρώδεις</span>”
				 <i><span class="en">
					Heraclit.
					<u>Incred.</u>
					23
				</span></i>
			; 
				“<span class="alpheios-lex-greek" lang="grc">π. κεφαλή</span>”
				 <i><span class="en">
					Philum.
					<u>Ven.</u>
					15.4
				</span></i>
			.</div>
