    <div class="alpheios-lex-entry" lemma-id="n40874" body-key=""><b><span class="alpheios-lex-greek" lang="grc">ἐπίσκῐ-ος</span></b> , <span class="alpheios-lex-greek" lang="grc">ον</span>,
			(<span class="alpheios-lex-greek" lang="grc">σκιά</span>) <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b><i>shaded, dark</i>, 
				“<span class="alpheios-lex-greek" lang="grc">τόπος</span>”
				 <i><span class="en">
					Pl.
					<u>R.</u>
					432c
				</span></i>
			, <i><span class="en">
				Arist.
				<u>HA</u>
				569b10
			</span></i>; 
