<div xmlns:perseus="http://www.perseus.org/meta/perseus.rdfs#" xmlns:dctype="http://purl.org/dc/dcmitype/" xmlns:tufts="http://www.tufts.edu/" xmlns:alph="http://alpheios.net/namespaces/tei" class="alpheios-lex-text_container en">
    <div class="alpheios-lex-entry" lemma-id="n39848" body-key=""><b><span class="alpheios-lex-greek" lang="grc">ἐπικουρ-ικός</span></b> , <span class="alpheios-lex-greek" lang="grc">ή</span>,
			<span class="alpheios-lex-greek" lang="grc">όν</span>, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b><i>serving as</i>
			
				“<span class="alpheios-lex-greek" lang="grc">ἐπίκουροι</span>”
				 <i><span class="en">
					1.3
				</span></i>
			, 
				“<span class="alpheios-lex-greek" lang="grc">γένος</span>”
				 <i><span class="en">
					Pl.
					<u>R.</u>
					434c
				</span></i>
			, <i><span class="en">
				441a
			</span></i>. </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense3"><b>2.</b>. mostly of
			troops, <i>auxiliary, mercenary</i>, 
				“<span class="alpheios-lex-greek" lang="grc">ἐπικουρικὸν μισθώσασθαι</span>”
				 <i><span class="en">
					Th.
					4.52
				</span></i>
			; <i>dependent on</i>
			
				“<span class="alpheios-lex-greek" lang="grc">ἐπίκουροι, πράγματα</span>”
				 <i><span class="en">
					Id.
					7.48
				</span></i>
			; <span class="alpheios-lex-greek" lang="grc">τὸ ἐ</span>. <i><span class="en">
				Ph.
				2.98
			</span></i>.</div>
    </div> <div class="alpheios-lex-footnotes en"> </div>
