    <div class="alpheios-lex-entry" lemma-id="n71419" body-key=""><b><span class="alpheios-lex-greek" lang="grc">νωφαιόν:</span></b> 
		<span class="alpheios-lex-greek" lang="grc">ἀφανές,</span>
		<i><span class="en">
			Hsch.
		</span></i>
		<b><span class="alpheios-lex-greek" lang="grc">νωφαλή&lt;σ&gt;:</span></b> 
		<span class="alpheios-lex-greek" lang="grc">νωθρός,</span> Id. <b><span class="alpheios-lex-greek" lang="grc">νωφρύς</span></b> , <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b>
				=
				<span class="alpheios-lex-greek" lang="grc">βαλλωτή</span>
			, Ps.-<i><span class="en">
				Dsc.
				3.103
			</span></i>. <b><span class="alpheios-lex-greek" lang="grc">νωχαλίζει:</span></b> 
			<span class="alpheios-lex-greek" lang="grc">βραδύνει,</span>
			<i><span class="en">
				Hsch.
			</span></i>
			<b><span class="alpheios-lex-greek" lang="grc">νωχᾰλός</span></b> , <span class="alpheios-lex-greek" lang="grc">ή</span>, <span class="alpheios-lex-greek" lang="grc">όν</span>, 
				=
				<span class="alpheios-lex-greek" lang="grc">νωχελής</span>
			, Id. (<span class="alpheios-lex-greek" lang="grc">νοχ-</span> cod.): 
				Comp.
			
			<span class="alpheios-lex-greek" lang="grc">-έστερος, ψυχή</span> Androcyd. ap.<i><span class="en">
				Clem.Al.
				<u>Strom.</u>
				7.6.33
			</span></i>.</div>
