    <div class="alpheios-lex-entry" lemma-id="n56983" body-key=""><b><span class="alpheios-lex-greek" lang="grc">κεφαλαι-ωτής</span></b> , <span class="alpheios-lex-greek" lang="grc">οῦ</span>,
			ὁ, = Lat. <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b><i>capitularius, secretary and treasurer of a group
				of landowners</i> or <i>artisans, acting as recruiting
				officer, taxcollector</i>, etc., <i><span class="en">
				<u>PThead.</u>
				22.4
			</span></i>
			<span class="entity">(iv A.D.)</span>, <i><span class="en">
				<u>PLips.</u>
				40 iii 17
			</span></i>
			<span class="entity">(iv/v A.D.)</span>, <i><span class="en">
				48.9
			</span></i> (pl., <span class="entity">iv A.D.</span>), al., <i><span class="en">
				<u>Cod.Theod.</u>
				11.24.6.7
			</span></i> (pl.); 
				“<span class="alpheios-lex-greek" lang="grc">τοῦ ἡγεμονικοῦ πολυκώπου</span>”
				 <i><span class="en">
					<u>PGrenf.</u>
					2.80
				</span></i>
			 (pl., <span class="entity">v A.D.</span>); 
				“<span class="alpheios-lex-greek" lang="grc">ταρσικαρίων</span>”
				 <i><span class="en">
					<u>PLips.</u>
					89
				</span></i>
			
			<span class="entity">(iv A.D.)</span>; 
				“<span class="alpheios-lex-greek" lang="grc">πιττακίων</span>”
				 <i><span class="en">
					<u>Sammelb.</u>
					4422.2
				</span></i>
			; <span class="alpheios-lex-greek" lang="grc">πλινθουργῶν</span> ib.<i><span class="en">
				5175.21
			</span></i>
			<span class="entity">(vi A.D.)</span>, al. </div>
