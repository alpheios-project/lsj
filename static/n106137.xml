    <div class="alpheios-lex-entry" lemma-id="n106137" body-key=""><b><span class="alpheios-lex-greek" lang="grc">ὑάλεος</span></b> 
		<span class="alpheios-lex-greek" lang="grc">[ᾰ]</span>, <span class="alpheios-lex-greek" lang="grc">α</span>, <span class="alpheios-lex-greek" lang="grc">ον</span><span class="alpheios-lex-greek" lang="grc">,
			ʽὕαλοσ̓</span>
		<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b>
				=
				<span class="alpheios-lex-greek" lang="grc">ὑάλινος</span>
			, <i>of glass,</i>
			
				“<span class="alpheios-lex-greek" lang="grc">κύλιξ</span>”
				 <i><span class="en">
					<u>AP</u>
					6.33
				</span></i>
			 (<i><span class="en">
				Maec.
			</span></i>); <span class="alpheios-lex-greek" lang="grc">ὄψις</span>
			<i>glass-coloured,</i> ib.<i><span class="en">
				12.249
			</span></i> (<i><span class="en">
				Strat.
			</span></i>):—
				contr.
			
			<b><span class="alpheios-lex-greek" lang="grc">ὑᾰλοῦς</span></b> , <span class="alpheios-lex-greek" lang="grc">ῆ</span>, <span class="alpheios-lex-greek" lang="grc">οῦν</span>,
				<i>of glass,</i>
			
				“<span class="alpheios-lex-greek" lang="grc">ὑαλᾶ σκεύη</span>”
				 <i><span class="en">
					Str.
					4.5.3
				</span></i>
			; 
				“<span class="alpheios-lex-greek" lang="grc">ἐκπώματα</span>”
				 <i><span class="en">
					Luc.
					<u>Hist.Conscr.</u>
					25
				</span></i>
			; 
				“<span class="alpheios-lex-greek" lang="grc">λάγυνοι</span>”
				 <i><span class="en">
					<u>POxy.</u>
					1294.6
				</span></i>
			
			<span class="entity">(ii/iii A. D.)</span>; also <b><span class="alpheios-lex-greek" lang="grc">ὑελοῦς</span></b> , <span class="alpheios-lex-greek" lang="grc">ῆ</span>, <span class="alpheios-lex-greek" lang="grc">οῦν</span>, Hippoloch. ap. <i><span class="en">
				Ath.
				4.129d
			</span></i>, <i><span class="en">
				Antyll.
			</span></i> ap. <i><span class="en">
				Orib.
				7.16.13
			</span></i>, <i><span class="en">
				Sor.
				<u>Fract.</u>
				2
			</span></i>, <i><span class="en">
				<u>PFay.</u>
				104.1
			</span></i>
			<span class="entity">(iii A. D.)</span>.</div>
