    <div class="alpheios-lex-entry" lemma-id="n70181" body-key=""><b><span class="alpheios-lex-greek" lang="grc">νέμ-ησις</span></b> , <span class="alpheios-lex-greek" lang="grc">εως</span>, ἡ, (<span class="alpheios-lex-greek" lang="grc">νέμω</span>) <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b><i>distribution,</i>
			
				“<span class="alpheios-lex-greek" lang="grc">τοῦ χωρίου</span>”
				 <i><span class="en">
					Is.
					9.17
				</span></i>
			; 
				“<span class="alpheios-lex-greek" lang="grc">τῶν κοινῶν</span>”
				 <i><span class="en">
					Phld.
					<u>Rh.</u>
					2.125
				</span></i>
			
			<i><span class="en">
				S.
			</span></i>; 
				“<span class="alpheios-lex-greek" lang="grc">οὐσίας</span>”
				 <i><span class="en">
					Poll.
					8.135
				</span></i>
			; 
				“<span class="alpheios-lex-greek" lang="grc">βασιλείας</span>”
				 <i><span class="en">
					J.
					<u>AJ</u>
					17.11.1
				</span></i>
			; 
				“<span class="alpheios-lex-greek" lang="grc">χρημάτων</span>”
