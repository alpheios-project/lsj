<div xmlns:perseus="http://www.perseus.org/meta/perseus.rdfs#" xmlns:dctype="http://purl.org/dc/dcmitype/" xmlns:tufts="http://www.tufts.edu/" xmlns:alph="http://alpheios.net/namespaces/tei" class="alpheios-lex-text_container en">
    <div class="alpheios-lex-entry" lemma-id="n91310" body-key=""><b><span class="alpheios-lex-greek" lang="grc">πῡγ-αῖος</span></b> , <span class="alpheios-lex-greek" lang="grc">α</span>,
			<span class="alpheios-lex-greek" lang="grc">ον</span>, (<span class="alpheios-lex-greek" lang="grc">πυγή</span>)
			<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b><i>of</i> or <i>on the
			rump</i>: </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>I.</b>
			<span class="alpheios-lex-greek" lang="grc">τὸ π.</span>,= <span class="alpheios-lex-greek" lang="grc">ἡ
				πυγή</span>, <i><span class="en">
				Hp.
				<u>Art.</u>
				57
			</span></i>,<i><span class="en">
				78
			</span></i>, <i><span class="en">
				Arist.
				<u>HA</u>
				620a15
			</span></i>: pl., <i><span class="en">
				Archipp.
				41
			</span></i> (s.v.l.), <i><span class="en">
				Sor.
				1.102
			</span></i>, <i><span class="en">
				Dsc.
				<u>Eup.</u>
				2.56
			</span></i>, <i><span class="en">
				Hsch.
			</span></i>, <i><span class="en">
				Phot.
			</span></i>; <span class="alpheios-lex-greek" lang="grc">τὸ π. ἄκρον</span>, of a bird,
				<i><span class="en">
				Hdt.
				2.76
			</span></i>. </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>II.</b>
			<span class="alpheios-lex-greek" lang="grc">πυγαῖα, τά</span>, in Architecture,= <span class="alpheios-lex-greek" lang="grc">σπεῖρα</span>, <i>base of a column</i>, <i><span class="en">
				Hsch.
			</span></i>
		</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>III.</b>
			
				=
				<span class="alpheios-lex-greek" lang="grc">κατάπυγος</span>
			, <i><span class="en">
				Suid.
			</span></i>
		</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>IV.</b>
			
				v.
				<span class="alpheios-lex-greek" lang="grc">πυγλίον</span>
			.</div>
