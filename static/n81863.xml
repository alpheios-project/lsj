			 (
				Pass.
			):—
				Pass.
			, 
				“<span class="alpheios-lex-greek" lang="grc">ἄγκιστρα περιπαρέντα τοῖς ἰχθύσι</span>”
				 <i><span class="en">
					Ael.
					<u>NA</u>
					15.10
				</span></i>
			.</div>
