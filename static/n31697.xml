			<i><span class="en">
				Ar.
				<u>V.</u>
				658
			</span></i>, <i><span class="en">
				X.
				<u>Ath.</u>
				1.17
			</span></i>, <i><span class="en">
				<u>PGnom.</u>
				85
			</span></i>, etc. ; 
				“<span class="alpheios-lex-greek" lang="grc">ἐκ τῶν χρημάτων ἑ.</span>”
				 <i><span class="en">
					<u>IG</u>
					2.721
				</span></i>
			
			<i><span class="en">
				<u>Ai</u>
				12
			</span></i> : also, 
				=
				<span class="alpheios-lex-greek" lang="grc">τόκοι ἑκατοστιαῖοι</span>
			, <i><span class="en">
				Plu.
				<u>Luc.</u>
				20
			</span></i>.</div>
