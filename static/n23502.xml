				 <i><span class="en">
					22.219
				</span></i>
			, al. :—nom. <b><span class="alpheios-lex-greek" lang="grc">δασπλῆτα</span></b> , <i><span class="en">
				Call.
				<u>Fr.</u>
				534
			</span></i>: <b><span class="alpheios-lex-greek" lang="grc">δασπλήτης</span></b> 
