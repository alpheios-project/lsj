    <div class="alpheios-lex-entry" lemma-id="n52272" body-key=""><b><span class="alpheios-lex-greek" lang="grc">κᾰκό-νοος</span></b> , <span class="alpheios-lex-greek" lang="grc">ον</span>, 
			contr.
		
		<b><span class="alpheios-lex-greek" lang="grc">κᾰκό-νους</span></b> , <span class="alpheios-lex-greek" lang="grc">ουν</span>: 
			Att.
		 pl. <span class="alpheios-lex-greek" lang="grc">κακόνοι</span>:—<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b><i>ill-disposed, disaffected</i>, opp. <span class="alpheios-lex-greek" lang="grc">εὔνους</span>, <i><span class="en">
				Antipho Soph.
				109
			</span></i>, <i><span class="en">
				Ar.
				<u>Pax</u>
				496
			</span></i> (lyr.), <i><span class="en">
				671
			</span></i>; 
				“<span class="alpheios-lex-greek" lang="grc">εὐνοεῖν τοῖς κακόνοις</span>”
				 <i><span class="en">
					X.
					<u>Cyr.</u>
					8.2.1
				</span></i>
			; <span class="alpheios-lex-greek" lang="grc">τινι</span>
			<i><span class="en">
				Id.
				<u>An.</u>
				2.5.16
			</span></i>; 
				“<span class="alpheios-lex-greek" lang="grc">τῇ πόλει</span>”
				 <i><span class="en">
					Th.
					6.24
				</span></i>
			; 
				“<span class="alpheios-lex-greek" lang="grc">τῷ πλήθει</span>”
				 <i><span class="en">
					Lys.
					25.7
				</span></i>
			; <span class="alpheios-lex-greek" lang="grc">τῷ δήμῳ κακόνους
			ἔσομαι</span>, oligarchical oath in <i><span class="en">
				Arist.
				<u>Pol.</u>
				1310a9
			</span></i>; 
				“<span class="alpheios-lex-greek" lang="grc">εἰς τὰ ὑμέτερα πράγματα</span>”
				 <i><span class="en">
					Lys.
					20.20
				</span></i>
			: 
				Sup.
			
			
				“<span class="alpheios-lex-greek" lang="grc">κακονούστατος</span>”
				 <i><span class="en">
					Id.
					7.28
				</span></i>
			, <i><span class="en">
				D.
				23.6
			</span></i>. Adv.
			<span class="alpheios-lex-greek" lang="grc">κακονόως</span> Sch.<i><span class="en">
				E.
				<u>Or.</u>
				108
			</span></i>; 
				“<span class="alpheios-lex-greek" lang="grc">κακόνως</span>”
				 <i><span class="en">
					Poll.
					5.115
				</span></i>
			: 
				Sup.
			
			<span class="alpheios-lex-greek" lang="grc">-νούστατα</span> ib.<i><span class="en">
				116
			</span></i>.</div>
