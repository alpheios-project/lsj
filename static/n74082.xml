    <div class="alpheios-lex-entry" lemma-id="n74082" body-key=""><b><span class="alpheios-lex-greek" lang="grc">ὀνήτωρ</span></b> , 
			Dor.
		
		<b><span class="alpheios-lex-greek" lang="grc">ὀνάτωρ</span></b> 
		<span class="alpheios-lex-greek" lang="grc">[ᾱ]</span>, <span class="alpheios-lex-greek" lang="grc">ορος</span>, ὁ, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b>
				=
				<span class="alpheios-lex-greek" lang="grc">ὀνήσιμος</span>
			, <i>beneficial,</i>
			
				“<span class="alpheios-lex-greek" lang="grc">τόκος ὀνάτωρ</span>”
				 <i><span class="en">
					Pi.
					<u>O.</u>
					10(11).9
				</span></i>
			(corr. <i><span class="en">
				Herm.
			</span></i> for <span class="alpheios-lex-greek" lang="grc">θνατῶν</span>), cf. <i><span class="en">
				<u>Trag.Adesp.</u>
				405
			</span></i> (cj. Bgk.), <i><span class="en">
				Hsch.
			</span></i> ; name of a plaster, 
				“<span class="alpheios-lex-greek" lang="grc">ὀ. εἰς ἅπαντα</span>”
				 <i><span class="en">
					Androm.
				</span></i>
			 ap. <i><span class="en">
				Gal.
				13.840
			</span></i>.</div>
