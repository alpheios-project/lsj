    <div class="alpheios-lex-entry" lemma-id="n66004" body-key=""><b><span class="alpheios-lex-greek" lang="grc">μελῐ-ηδής</span></b> , 
			Dor.
		
		<b><span class="alpheios-lex-greek" lang="grc">μελῐ-ᾱδής</span></b> , <span class="alpheios-lex-greek" lang="grc">ές</span>, 
			Aeol.
		
		<b><span class="alpheios-lex-greek" lang="grc">μελῐ-άδης</span></b> , (<span class="alpheios-lex-greek" lang="grc">ἡδύς</span>) <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b><i>honey-sweet</i>, 
				“<span class="alpheios-lex-greek" lang="grc">οἴνου . . μελιηδέος</span>”
				 <i><span class="en">
					Il.
					4.346
				</span></i>
			; 
				“<span class="alpheios-lex-greek" lang="grc">οἶνός σε τρώει μελιηδής</span>”
				 <i><span class="en">
					Od.
					21.293
				</span></i>
			; 
				“<span class="alpheios-lex-greek" lang="grc">λωτοῖο μελιηδέα καρπόν</span>”
				 <i><span class="en">
					9.94
				</span></i>
			; <span class="alpheios-lex-greek" lang="grc">τὼ μελιάδεος</span> (sc. <span class="alpheios-lex-greek" lang="grc">οἴνου</span>) <i><span class="en">
				Alc.
				45
			</span></i>, cf. <i><span class="en">
				Id.
				p.31
			</span></i> Lobel, <i><span class="en">
				Pi.
				<u>Fr.</u>
				166.1
			</span></i>. </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense3"><b>2.</b> metaph., 
				“<span class="alpheios-lex-greek" lang="grc">μελιηδέα θυμὸν ἀπηύρα</span>”
				 <i><span class="en">
					Il.
					10.495
				</span></i>
			; 
				“<span class="alpheios-lex-greek" lang="grc">νόστον δίζηαι μελιηδέα</span>”
				 <i><span class="en">
					Od.
					11.100
				</span></i>
			; 
				“<span class="alpheios-lex-greek" lang="grc">ἐμὲ μελιηδὴς ὕπνος ἀνῆκε</span>”
				 <i><span class="en">
					19.551
				</span></i>
			; 
				“<span class="alpheios-lex-greek" lang="grc">γᾶρυς</span>”
				 <i><span class="en">
					Simon.
					41
				</span></i>
			.</div>
