    <div class="alpheios-lex-entry" lemma-id="n44300" body-key=""><b><span class="alpheios-lex-greek" lang="grc">εὔκραιρος</span></b> , 
			Ep.
		
		<b><span class="alpheios-lex-greek" lang="grc">ἐϋκρ-</span></b> , <span class="alpheios-lex-greek" lang="grc">ον</span>, also <span class="alpheios-lex-greek" lang="grc">η</span>, <span class="alpheios-lex-greek" lang="grc">ον</span>, (<span class="alpheios-lex-greek" lang="grc">κραῖρα</span>) <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b><i>with fine horns</i>, esp. of oxen, 
				“<span class="alpheios-lex-greek" lang="grc">βουσὶν ἐϋκραίρῃσιν</span>”
				 <i><span class="en">
					<u>h.Merc.</u>
					209
				</span></i>
			; 
				“<span class="alpheios-lex-greek" lang="grc">εὐκραίρῳ βοΐ</span>”
				 <i><span class="en">
					A.
					<u>Supp.</u>
					300
				</span></i>
			. </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense3"><b>2.</b> of ships,
				<i>with beautiful beak</i>, <i><span class="en">
				Opp.
				<u>H.</u>
				2.516
			</span></i>, <i><span class="en">
				Tryph.
				213
			</span></i>.</div>
