    <div class="alpheios-lex-entry" lemma-id="n23876" body-key=""><b><span class="alpheios-lex-greek" lang="grc">δεκάρχ-ης</span></b> , <span class="alpheios-lex-greek" lang="grc">ου</span>, ὁ, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b>
				=
				<span class="alpheios-lex-greek" lang="grc">δεκαδάρχης</span>
			, <i>decurion,</i>
			<i><span class="en">
				Hdt.
				7.81
			</span></i>; = Lat. <i>decurio</i> (in form <b><span class="alpheios-lex-greek" lang="grc">δέκαρχος</span></b> ), <i><span class="en">
				Arr.
				<u>Alan.</u>
				22
			</span></i>, <i><span class="en">
				D.C.
				71.27
			</span></i>. </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>II.</b>
			= Lat. <i>decemvir,</i>
			f.l. in
			<i><span class="en">
				D.H.
				2.14
			</span></i>.</div>
