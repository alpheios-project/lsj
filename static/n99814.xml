				 <i><span class="en">
					Sor.
					1.56
				</span></i>
			; 
				“<span class="alpheios-lex-greek" lang="grc">-ίζοντος τοῦ ἡλίου</span>”
				 <i><span class="en">
					Gem.
					17.28
				</span></i>
			; <i>approximate</i>, 
				“<span class="alpheios-lex-greek" lang="grc">τῇ τῶν ἀγαθῶν φύσει</span>”
