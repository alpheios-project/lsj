    <div class="alpheios-lex-entry" lemma-id="n104950" body-key=""><b><span class="alpheios-lex-greek" lang="grc">τρῐηρ-ικός</span></b> , <span class="alpheios-lex-greek" lang="grc">ή</span>,
			<span class="alpheios-lex-greek" lang="grc">όν</span>, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b>
				=
				<span class="alpheios-lex-greek" lang="grc">τριηριτικός, σκεύη</span>
			
			<i><span class="en">
				D.
				47.19
			</span></i>; 
				“<span class="alpheios-lex-greek" lang="grc">λιμήν</span>”
				 <i><span class="en">
					Str.
					14.2.15
				</span></i>
			, cj. in <i><span class="en">
				13.2.2
			</span></i>; <span class="alpheios-lex-greek" lang="grc">αὐλεῖν τὸ τ.</span> (sc.
				<span class="alpheios-lex-greek" lang="grc">μέλος</span>) <i><span class="en">
				Ath.
				12.535d
			</span></i>; but 
				“<span class="alpheios-lex-greek" lang="grc">τὸ τ.</span>”
				<i>the class which serves in a trireme,</i>
				 <i><span class="en">
					Arist.
					<u>Pol.</u>
					1291b23
				</span></i>
			.</div>
