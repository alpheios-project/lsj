    <div class="alpheios-lex-entry" lemma-id="n107543" body-key=""><b><span class="alpheios-lex-greek" lang="grc">ὑπερήνωρ</span></b> , 
			Dor.
		
		<b><span class="alpheios-lex-greek" lang="grc">ὑπερηνορ-άνωρ</span></b> , <span class="alpheios-lex-greek" lang="grc">ορος</span>, ὁ, ἡ, (<span class="alpheios-lex-greek" lang="grc">ἀνήρ</span>)
		= foreg., <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b><i>overbearing, overweening,</i> of the tyrant Pelias, <i><span class="en">
				Hes.
				<u>Th.</u>
				995
			</span></i>; 
				“<span class="alpheios-lex-greek" lang="grc">θήρ</span>”
				 <i><span class="en">
					Orph.
					<u>A.</u>
					944
				</span></i>
			; also 
				“<span class="alpheios-lex-greek" lang="grc">μεγαλαγορία</span>”
				 <i><span class="en">
					E.
					<u>Ph.</u>
					184
				</span></i>
			 (lyr.); 
				“<span class="alpheios-lex-greek" lang="grc">θυμός</span>”
				 <i><span class="en">
					Orph.
					<u>A.</u>
					671
				</span></i>
			.—In <i><span class="en">
				Hom.
			</span></i> only as pr. n.</div>
