    <div class="alpheios-lex-entry" lemma-id="n94660" body-key=""><b><span class="alpheios-lex-greek" lang="grc">σκελετ-ός</span></b> , <span class="alpheios-lex-greek" lang="grc">ή</span>,
			<span class="alpheios-lex-greek" lang="grc">όν</span>, (<span class="alpheios-lex-greek" lang="grc">σκέλλω</span>)
			<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b><i>dried up, withered</i>, 
				“<span class="alpheios-lex-greek" lang="grc">Κινησίας ς., ἄπυγος</span>”
				 <i><span class="en">
					Pl.Com.
					184.3
				</span></i>
			; 
				“<span class="alpheios-lex-greek" lang="grc">ς. δάκος</span>”
				 <i><span class="en">
					Nic.
					<u>Th.</u>
					696
				</span></i>
			. </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>II.</b>
			Subst.
			<span class="alpheios-lex-greek" lang="grc">σκελετός, ὁ</span>, <i>dried body, mummy</i>, <span class="alpheios-lex-greek" lang="grc">Λάμπρος . . Μουσῶν ς</span>. <i><span class="en">
				Phryn.Com.
				69
			</span></i>, cf. <i><span class="en">
				Str.
				17.3.8
			</span></i>, <i><span class="en">
				Plu.
				2.148a
			</span></i>, <i><span class="en">
				735f
			</span></i>; <span class="alpheios-lex-greek" lang="grc">ἡμιθανῆ ς</span>. <i><span class="en">
				<u>AP</u>
				11.392
			</span></i> (<i><span class="en">
				Lucill.
			</span></i>); <span class="alpheios-lex-greek" lang="grc">τῶν ὑπὸ γῆν ς.
			λεπτότατος</span> ib.<i><span class="en">
				92
			</span></i> (Id.); 
				“<span class="alpheios-lex-greek" lang="grc">κείσεται ς. καὶ τὸ μηδὲν γενόμενος</span>”
				 <i><span class="en">
					Plu.
					<u>Ant.</u>
					75
				</span></i>
			. </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense3"><b>2.</b>
			<i>skeleton</i>, <i><span class="en">
				Phld.
				<u>Mort.</u>
				30
			</span></i>, <i><span class="en">
				Gal.
				2.221
			</span></i>,<i><span class="en">
				222
			</span></i>,<i><span class="en">
				734
			</span></i>, al. </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>III.</b>
			
				v.
				<span class="alpheios-lex-greek" lang="grc">σκελετά</span>
			.</div>
