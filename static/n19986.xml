    <div class="alpheios-lex-entry" lemma-id="n19986" body-key=""><b><span class="alpheios-lex-greek" lang="grc">βί̆οτ-ος</span></b> , ὁ, 
			Ep.
		, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b>
				=
				<span class="alpheios-lex-greek" lang="grc">βίος</span>
			
			<i><span class="en">
				1
			</span></i>, <i>life</i>, 
				“<span class="alpheios-lex-greek" lang="grc">βιότοιο τελευτή</span>”
				 <i><span class="en">
					Il.
					7.104
				</span></i>
			, cf. <i><span class="en">
				Emp.
				15.2
			</span></i>, <i><span class="en">
				A.
				<u>Pers.</u>
				360
			</span></i>, al. </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>II.</b>
			
				=
				<span class="alpheios-lex-greek" lang="grc">βίος</span>
			
			<i><span class="en">
				11
			</span></i>, <i>means of living, substance</i>, 
				“<span class="alpheios-lex-greek" lang="grc">ναῖε δὲ δῶμα ἀφνειὸν βιότοιο</span>”
				 <i><span class="en">
					Il.
					14.122
				</span></i>
			; 
				“<span class="alpheios-lex-greek" lang="grc">β. κατακείρετε πολλόν</span>”
				 <i><span class="en">
					Od.
					4.686
				</span></i>
			; 
				“<span class="alpheios-lex-greek" lang="grc">γύαι φέρουσι β. ἄφθονον βροτοῖς</span>”
				 <i><span class="en">
					A.
					<u>Fr.</u>
					196
				</span></i>
			; 
				“<span class="alpheios-lex-greek" lang="grc">βιότου κτῆσις</span>”
				 <i><span class="en">
					Ar.
					<u>Av.</u>
					718
				</span></i>
			, cf. <i><span class="en">
				<u>Ec.</u>
				669
			</span></i>:—in late Prose, <i><span class="en">
				<u>PLond.</u>
				5.1889
			</span></i>
			<span class="entity">(vi A.D.)</span>. </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>III.</b>
			
				=
				<span class="alpheios-lex-greek" lang="grc">βίος</span>
			
			<i><span class="en">
				111
			</span></i>, <i>the world, mankind</i>, 
				“<span class="alpheios-lex-greek" lang="grc">μνήμῃ βιότου παρέδωκεν</span>”
				 <i><span class="en">
					<u>Epigr.Gr.</u>
					319
				</span></i>
			 (<span class="entity">Philadelphia</span>).</div>
