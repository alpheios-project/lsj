    <div class="alpheios-lex-entry" lemma-id="n22175" body-key=""><b><span class="alpheios-lex-greek" lang="grc">Γῐγάντ-ειος</span></b> , <span class="alpheios-lex-greek" lang="grc">α</span>,
			<span class="alpheios-lex-greek" lang="grc">ον</span>, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b><i>gigantic,</i>
			<i><span class="en">
				AP
				9.708
			</span></i> (<i><span class="en">
				Phil.
			</span></i>), <i><span class="en">
				Luc.
				<u>Philops.</u>
				23
			</span></i>:— also <b><span class="alpheios-lex-greek" lang="grc">Γῐγανταῖος</span></b> , <span class="alpheios-lex-greek" lang="grc">α</span>, <span class="alpheios-lex-greek" lang="grc">ον</span>, <i><span class="en">
				Aesop.
				53
			</span></i>, <i><span class="en">
				Hsch.
			</span></i>
			
				s.v.
				<span class="alpheios-lex-greek" lang="grc">Ἀβραμιαῖος</span>
			: <b><span class="alpheios-lex-greek" lang="grc">Γῐγαντιαῖος</span></b> , 
				“<span class="alpheios-lex-greek" lang="grc">σώματα</span>”
				 <i><span class="en">
					Pall.
					<u>in Hp.</u>
					2.143
				</span></i>
			
			<i><span class="en">
				D.
			</span></i>: <b><span class="alpheios-lex-greek" lang="grc">Γῐγαντικός</span></b> ,
				<span class="alpheios-lex-greek" lang="grc">ή</span>, <span class="alpheios-lex-greek" lang="grc">όν</span>,
				<i>of</i> or <i>for the Giants</i>, 
				“<span class="alpheios-lex-greek" lang="grc">τὰ -κά</span>”
				 <i><span class="en">
					Plu.
					2.360f
				</span></i>
			; <i>monstrous</i>, 
				“<span class="alpheios-lex-greek" lang="grc">θρασύτης</span>”
