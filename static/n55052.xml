    <div class="alpheios-lex-entry" lemma-id="n55052" body-key=""><b><span class="alpheios-lex-greek" lang="grc">κατάρρο-ος</span></b> , <span class="alpheios-lex-greek" lang="grc">ον</span>, 
			contr.
		
		<b><span class="alpheios-lex-greek" lang="grc">καταρρό-ρους</span></b> , <span class="alpheios-lex-greek" lang="grc">ουν</span>, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b><i>down-flowing</i>, 
				“<span class="alpheios-lex-greek" lang="grc">Νεῖλος</span>”
				 <i><span class="en">
					Philostr.
					<u>VA</u>
					6.23
				</span></i>
			. </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense3"><b>2.</b>
			<i>full of streams</i>, 
				“<span class="alpheios-lex-greek" lang="grc">νῆσος</span>”
