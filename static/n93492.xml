				 <i><span class="en">
					Arist.
					<u>Resp.</u>
					474b14
				</span></i>
			, cf. <i><span class="en">
				<u>Juv.</u>
				469b23
			</span></i>, <i><span class="en">
				Thphr.
				<u>Ign.</u>
