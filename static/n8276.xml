    <div class="alpheios-lex-entry" lemma-id="n8276" body-key=""><b><span class="alpheios-lex-greek" lang="grc">ἀνενέργ-ητος</span></b> , <span class="alpheios-lex-greek" lang="grc">ον</span>,
			<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b><i>inefficacious, inactive,</i>
			<i><span class="en">
				Ruf.
				<u>Anat.</u>
				30
			</span></i>, <i><span class="en">
				S.E.
				<u>M.</u>
				7.30
			</span></i>, cf. <i><span class="en">
				Alex.Aphr.
				<u>de An.</u>
				39.8
			</span></i>, <i><span class="en">
				Hierocl.
				<u>in CA</u>
				21p.466M.
			</span></i>; 
