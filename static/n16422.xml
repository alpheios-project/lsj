    <div class="alpheios-lex-entry" lemma-id="n16422" body-key=""><b><span class="alpheios-lex-greek" lang="grc">ἄσπρος</span></b> , <span class="alpheios-lex-greek" lang="grc">α</span>, <span class="alpheios-lex-greek" lang="grc">ον</span>, = Lat. <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b><i>asper,</i>
			<i><span class="en">
				Ael.
				<u>NA</u>
				1.26
			</span></i>. </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>II.</b>
			<span class="alpheios-lex-greek" lang="grc">ἄ. γράμματα</span>
