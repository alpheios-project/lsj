    <div class="alpheios-lex-entry" lemma-id="n5182" body-key=""><b><span class="alpheios-lex-greek" lang="grc">ἀμετά-βολος</span></b> , <span class="alpheios-lex-greek" lang="grc">ον</span>,
			= foreg., <i><span class="en">
			Plu.
			<u>Mar.</u>
			42
		</span></i>. <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense3"><b>2.</b> Music, <i>without
				modulation,</i>
			
				“<span class="alpheios-lex-greek" lang="grc">σύστημα</span>”
				 <i><span class="en">
					Aristid.Quint.
					1.8
				</span></i>
			, <i><span class="en">
				Bacch.
				<u>Harm.</u>
				74
			</span></i>; 
				“<span class="alpheios-lex-greek" lang="grc">ἁρμονία</span>”
				 <i><span class="en">
					Plu.
					2.437d
				</span></i>
			
			<b><span class="alpheios-lex-greek" lang="grc">ἀμετά-γνωστος</span></b> , <span class="alpheios-lex-greek" lang="grc">ον</span>, <i>unalterable, implacable,</i>
			
				“<span class="alpheios-lex-greek" lang="grc">μῖσος</span>”
