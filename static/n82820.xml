    <div class="alpheios-lex-entry" lemma-id="n82820" body-key=""><b><span class="alpheios-lex-greek" lang="grc">πευκάλῐμος</span></b>  [<span class="alpheios-lex-greek" lang="grc">ᾰ], <span class="alpheios-lex-greek" lang="grc">η</span>, <span class="alpheios-lex-greek" lang="grc">ον</span></span>, 
