    <div class="alpheios-lex-entry" lemma-id="n44579" body-key=""><b><span class="alpheios-lex-greek" lang="grc">εὔξοος</span></b> , 
			Ep.
		
		<b><span class="alpheios-lex-greek" lang="grc">ἐΰξοος</span></b> , <span class="alpheios-lex-greek" lang="grc">ον</span>, gen. <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b>
				“<span class="alpheios-lex-greek" lang="grc">ἐΰξου</span>”
				 <i><span class="en">
					Il.
					10.373
				</span></i>
			:— 
				=
				<span class="alpheios-lex-greek" lang="grc">εὔξεστος, ἅρμα,
				δίφρος</span>
			, <i><span class="en">
				Il.
				2.390
			</span></i>, <i><span class="en">
				Od.
				4.590
			</span></i>; 
				“<span class="alpheios-lex-greek" lang="grc">δόρυ</span>”
				 <i><span class="en">
					Il.
					10.373
				</span></i>
			; <span class="alpheios-lex-greek" lang="grc">σκέπαρνον ἐΰ</span>. an axe
				<i>of polished metal</i> or <i>haft</i>, <i><span class="en">
				Od.
				5.237
			</span></i>. </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>II.</b>
			<i>easy to polish</i>, 
				“<span class="alpheios-lex-greek" lang="grc">εὐξοώτερα</span>”
				 <i><span class="en">
					Thphr.
					<u>HP</u>
					5.6.4
				</span></i>
			.</div>
