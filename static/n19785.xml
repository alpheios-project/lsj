    <div class="alpheios-lex-entry" lemma-id="n19785" body-key=""><b><span class="alpheios-lex-greek" lang="grc">βέλτ-ερος</span></b> , <span class="alpheios-lex-greek" lang="grc">α</span>,
			<span class="alpheios-lex-greek" lang="grc">ον</span>, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b>
				=
				<span class="alpheios-lex-greek" lang="grc">βελτίων</span>
