    <div class="alpheios-lex-entry" lemma-id="n105402" body-key=""><b><span class="alpheios-lex-greek" lang="grc">τριχθ-ά</span></b> , 
			Ep.
		
		Adv.
		<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b>
				=
				<span class="alpheios-lex-greek" lang="grc">τρίχα</span>
			, <i>into</i> or <i>in three parts,</i>
			
				“<span class="alpheios-lex-greek" lang="grc">τ. ᾤκηθεν</span>”
				 <i><span class="en">
					Il.
					2.668
				</span></i>
			; 
			
				“<span class="alpheios-lex-greek" lang="grc">τ. πάντα δέδασται</span>”
				 <i><span class="en">
					15.189
				</span></i>
			; 
				“<span class="alpheios-lex-greek" lang="grc">τ. τε καὶ τετραχθὰ διατρυφέν</span>”
				<i>into three pieces,</i>
				 <i><span class="en">
					3.363
				</span></i>
			, cf. <i><span class="en">
				Od.
				9.71
			</span></i>.</div>
