    <div class="alpheios-lex-entry" lemma-id="n88426" body-key=""><b><span class="alpheios-lex-greek" lang="grc">προρέω</span></b> , 
			Ep.
		 Verb, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b><i>flow
			forward</i> or <i>forth, flow amain,</i> of rivers and streams,
				<i><span class="en">
				Il.
				21.260
			</span></i>, <i><span class="en">
				Od.
				5.444
			</span></i>, etc.; 
				“<span class="alpheios-lex-greek" lang="grc">ἅλαδε προρέουσι</span>”
				 <i><span class="en">
					Il.
					12.19
				</span></i>
			, cf.<i><span class="en">
				5.598
			</span></i>; 
				“<span class="alpheios-lex-greek" lang="grc">εἰς ἅλαδε</span>”
				 <i><span class="en">
					Od.
					10.351
				</span></i>
			; 
				“<span class="alpheios-lex-greek" lang="grc">ἐκ πέτρης</span>”
				 <i><span class="en">
					Hes.
					<u>Th.</u>
					792
				</span></i>
			. </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>II.</b> trans.,
				<i>pour forth,</i>
			<i><span class="en">
				h.Ap.
				380
			</span></i>; [
				“<span class="alpheios-lex-greek" lang="grc">κρήνη] ὕδωρ προρέεσκε</span>”
				 <i><span class="en">
					A.R.
					3.225
				</span></i>
			, cf. <i><span class="en">
				Orph.
				<u>A.</u>
				1132
			</span></i>.</div>
