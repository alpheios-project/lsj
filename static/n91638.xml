    <div class="alpheios-lex-entry" lemma-id="n91638" body-key=""><b><span class="alpheios-lex-greek" lang="grc">πῠρ-εύς</span></b> , <span class="alpheios-lex-greek" lang="grc">έως</span>,
			ὁ, (<span class="alpheios-lex-greek" lang="grc">πῦρ</span>) <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b><i>one who lights fire</i> or
				<i>burns</i>, <i><span class="en">
				Hsch.
			</span></i> (pl.); <span class="alpheios-lex-greek" lang="grc">πυρις</span> (sic), =
			<i>flamines,</i>
			<i><span class="en">
				Gloss.
			</span></i> (fort. <span class="alpheios-lex-greek" lang="grc">ἱερεῖς</span>).
			</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>II.</b>
			<i>fire-proof vessel</i>, cj. in <i><span class="en">
				<u>AP</u>
				13.13
			</span></i>.</div>
