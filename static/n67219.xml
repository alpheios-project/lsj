				 <i><span class="en">
					App.
					<u>Hisp.</u>
					78
				</span></i>
			, cf. <i><span class="en">
				Tz.
				<u>H.</u>
				1.823
			</span></i>: metaph., <i>divert</i>, <i><span class="en">
