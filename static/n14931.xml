    <div class="alpheios-lex-entry" lemma-id="n14931" body-key=""><b><span class="alpheios-lex-greek" lang="grc">Ἀρει-μάνιος</span></b>  [<span class="alpheios-lex-greek" lang="grc">μᾰ],
				<span class="alpheios-lex-greek" lang="grc">ον</span>,</span>
		= foreg., <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b>
				“<span class="alpheios-lex-greek" lang="grc">θρασύτης</span>”
				 <i><span class="en">
					Ph.
					1.375
				</span></i>
			; 
				“<span class="alpheios-lex-greek" lang="grc">δυνάστης</span>”
				 <i><span class="en">
					Plu.
					2.321f
				</span></i>
			, cf. <i><span class="en">
				758f
			</span></i>; 
				“<span class="alpheios-lex-greek" lang="grc">κριός</span>”
				 <i><span class="en">
					D.L.
					6.61
				</span></i>
			; 
				“<span class="alpheios-lex-greek" lang="grc">φῦλα</span>”
				 <i><span class="en">
					J.
					<u>BJ</u>
					2.16.4
				</span></i>
			. </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>II.</b>
			<span class="alpheios-lex-greek" lang="grc">Ἀρειμάνιος, ὁ,</span> as pr. n., = Avest.
				<i>angrō mainyuš,</i> a name given by the
			Magi to <i>the Spirit of Evil,</i> opp. Oromasdes ( =
			Ahuramazda), <i><span class="en">
				Arist.
				<u>Fr.</u>
				6
			</span></i>, <i><span class="en">
				Plu.
				2.369e
			</span></i>, <i><span class="en">
				Dam.
				<u>Pr.</u>
				125
			</span></i> bis.</div>
