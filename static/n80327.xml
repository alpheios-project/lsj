			 ; <span class="alpheios-lex-greek" lang="grc">πείθοντες</span>, opp.<span class="alpheios-lex-greek" lang="grc">βίᾳ</span>, <i><span class="en">
				X.
				<u>An.</u>
				5.5.11
			</span></i> ; <span class="alpheios-lex-greek" lang="grc">π. γυναῖκα</span>, opp. <span class="alpheios-lex-greek" lang="grc">βιάζεσθαι</span>, <i><span class="en">
				Id.
				<u>Cyr.</u>
				6.1.34
			</span></i> ; <span class="alpheios-lex-greek" lang="grc">πέπεικε</span>, opp. <span class="alpheios-lex-greek" lang="grc">ἠνάγκακε</span>, <i><span class="en">
