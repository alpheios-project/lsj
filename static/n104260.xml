    <div class="alpheios-lex-entry" lemma-id="n104260" body-key=""><b><span class="alpheios-lex-greek" lang="grc">τον-αῖος</span></b> , <span class="alpheios-lex-greek" lang="grc">α</span>, <span class="alpheios-lex-greek" lang="grc">ον</span>, (<span class="alpheios-lex-greek" lang="grc">τόνος</span>) <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b><i>stretched,</i>
			
				“<span class="alpheios-lex-greek" lang="grc">δρόμος</span>”
				 <i><span class="en">
					Suid.
				</span></i>
			, <i><span class="en">
				Zonar.
			</span></i>
		</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>II.</b>
			<span class="alpheios-lex-greek" lang="grc">τοναία</span> (sc. <span class="alpheios-lex-greek" lang="grc">φωνή</span>), ἡ, <i>strained,
				loud voice,</i>
			<i><span class="en">
				Alex.
				169
			</span></i>. </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>III.</b>
			<span class="alpheios-lex-greek" lang="grc">Τόναια, τά,</span>
			
				v.
				<span class="alpheios-lex-greek" lang="grc">Τόνεα.</span>
			
		</div>
