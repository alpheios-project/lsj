    <div class="alpheios-lex-entry" lemma-id="n110661" body-key=""><b><span class="alpheios-lex-greek" lang="grc">φθᾰτέω</span></b> , aor.
		subj.
		<span class="alpheios-lex-greek" lang="grc">φθατήσῃ,</span> glossed <span class="alpheios-lex-greek" lang="grc">φθάσῃ,</span>
		<i><span class="en">
			Hsch.
		</span></i>; cf. <span class="alpheios-lex-greek" lang="grc">καταφθατόομαι</span> (or rather
			<span class="alpheios-lex-greek" lang="grc">-έομαι</span>); also <b><span class="alpheios-lex-greek" lang="grc">ψᾰτᾶσθαι</span></b> , <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b>
				=
				<span class="alpheios-lex-greek" lang="grc">προκαταλαμβάνειν</span>
			, Id.; <span class="alpheios-lex-greek" lang="grc">ψατῆσαι,</span>
			
				=
				<span class="alpheios-lex-greek" lang="grc">προειπεῖν</span>
			, Id.</div>
