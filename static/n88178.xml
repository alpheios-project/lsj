    <div class="alpheios-lex-entry" lemma-id="n88178" body-key=""><b><span class="alpheios-lex-greek" lang="grc">πρό-οπτος</span></b> , 
			Att.
		
		
			contr.
		
		<b><span class="alpheios-lex-greek" lang="grc">προὖπτος</span></b> , <span class="alpheios-lex-greek" lang="grc">ον</span>, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b><i>foreseen,
				manifest,</i>
			
				“<span class="alpheios-lex-greek" lang="grc">προόπτῳ θανάτῳ δώσειν τινά</span>”
				 <i><span class="en">
					Hdt.
					9.17
				</span></i>
			, cf. <i><span class="en">
				Isoc.
				10.27
			</span></i>; 
				“<span class="alpheios-lex-greek" lang="grc">ἐς προὖπτον κίνδυνον καταστῆσαι</span>”
				 <i><span class="en">
					Th.
					5.99
				</span></i>
			, cf. <i><span class="en">
				111
			</span></i>; 
				“<span class="alpheios-lex-greek" lang="grc">π. ἀγγέλου λόγος</span>”
				 <i><span class="en">
					A.
					<u>Th.</u>
					848
				</span></i>
			 (lyr.); 
				“<span class="alpheios-lex-greek" lang="grc">ἐς προὖπτον Ἅιδην</span>”
				 <i><span class="en">
					S.
					<u>OC</u>
					1440
				</span></i>
			, cf. <i><span class="en">
				E.
				<u>Hipp.</u>
				1366
			</span></i> (anap.); 
				“<span class="alpheios-lex-greek" lang="grc">εἰς προὖπτον . . αὑτὸν ἐνέβαλεν
					κακόν</span>”
				 <i><span class="en">
					Aristopho
					5
				</span></i>
			; 
				“<span class="alpheios-lex-greek" lang="grc">εἰς προὖπτον . . ἐμπεσεῖν κακόν</span>”
				 <i><span class="en">
					Phoenicid.
					4.18
				</span></i>
			.</div>
