			; 
				“<span class="alpheios-lex-greek" lang="grc">ἀ. καὶ ἀθέως</span>”
				 <i><span class="en">
					Antipho
					1.23
				</span></i>
			: 
				Sup.
			
			
				“<span class="alpheios-lex-greek" lang="grc">ἀβουλότατα</span>”
