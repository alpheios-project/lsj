        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>III.</b>
			<b><span class="alpheios-lex-greek" lang="grc">Πάνεια</span></b> , τά, festival of Pan at Delos, <i><span class="en">
				<u>Inscr.Délos</u>
				312.6
			</span></i>, <i><span class="en">
				320
			</span></i>
			<i><span class="en">
				<u>B</u>
				58
			</span></i>
			<span class="entity">(iii B. C.)</span>.</div>
