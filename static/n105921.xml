    <div class="alpheios-lex-entry" lemma-id="n105921" body-key=""><b><span class="alpheios-lex-greek" lang="grc">τυντλ-άζω</span></b> , <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b>
				=
				<span class="alpheios-lex-greek" lang="grc">πηλοπατέω</span>
			 or <span class="alpheios-lex-greek" lang="grc">βωλοκοπέω</span> (acc. to Sch.),
			or 
				=
				<span class="alpheios-lex-greek" lang="grc">σκάπτειν ἀμπέλους</span>
			 (acc. to <i><span class="en">
				Hsch.
			</span></i>), <i><span class="en">
				Ar.
				<u>Pax</u>
				1148
			</span></i> (troch.); 
				=
				<span class="alpheios-lex-greek" lang="grc">ἐπιρραίνειν πηλῷ</span>
			, <i><span class="en">
				Phot.
			</span></i>:—metaph. in 
				Pass.
			, 
				“<span class="alpheios-lex-greek" lang="grc">ὁ δ᾽ ἀγνοῶν ταῦτ᾽ εἰκότως -άζεται</span>”
				 <i><span class="en">
					Sosip.
					1.35
				</span></i>
			.</div>
