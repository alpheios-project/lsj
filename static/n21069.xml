    <div class="alpheios-lex-entry" lemma-id="n21069" body-key=""><b><span class="alpheios-lex-greek" lang="grc">βρουλός:</span></b> 
		<span class="alpheios-lex-greek" lang="grc">πονηρός</span>, <i><span class="en">
			Hsch.
		</span></i>
		<b><span class="alpheios-lex-greek" lang="grc">βροῦνος:</span></b> 
		<span class="alpheios-lex-greek" lang="grc">ἐνεὸς ἢ μαινόμενος</span>, Id. <b><span class="alpheios-lex-greek" lang="grc">βρούξ:</span></b> 
		<span class="alpheios-lex-greek" lang="grc">τράχηλος, βρόγχος</span>, Id. <b><span class="alpheios-lex-greek" lang="grc">βρούτιδες:</span></b> 
		<span class="alpheios-lex-greek" lang="grc">γυναῖκες οὕτω καλούμεναι</span>, <i><span class="en">
			Cyr.
		</span></i>, <i><span class="en">
			Suid.
		</span></i>
		<b><span class="alpheios-lex-greek" lang="grc">βροῦτος</span></b> , <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b>
				=
				<span class="alpheios-lex-greek" lang="grc">βρῦτος</span>
			, <i><span class="en">
				Hsch.
			</span></i>
			<b><span class="alpheios-lex-greek" lang="grc">βροῦχαλ:</span></b> 
			<span class="alpheios-lex-greek" lang="grc">θερμός</span>, Id. <b><span class="alpheios-lex-greek" lang="grc">βρούχετος:</span></b> 
			<span class="alpheios-lex-greek" lang="grc">βάρβαρος</span>: also, 
				=
				<span class="alpheios-lex-greek" lang="grc">βάτραχος</span>
			 (<i><span class="en">
				Cypr.
			</span></i>), Id.</div>
