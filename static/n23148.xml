    <div class="alpheios-lex-entry" lemma-id="n23148" body-key=""><b><span class="alpheios-lex-greek" lang="grc">γῶνοπ</span></b> , <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b>
				=
				<span class="alpheios-lex-greek" lang="grc">γωνία</span>
			(
				Lacon.
			), <i><span class="en">
				Hsch.
			</span></i>
			<b><span class="alpheios-lex-greek" lang="grc">γωνορίσματα:</span></b> 
			<span class="alpheios-lex-greek" lang="grc">γνωρίσματα, τοποθεσίαι,</span> Id. <b><span class="alpheios-lex-greek" lang="grc">γῶνος:</span></b> 
			<span class="alpheios-lex-greek" lang="grc">γουνός, ἕδος, καὶ παιδιά τις
				παλαιστρική, οἱ δὲ κώπη,</span> Id. <b><span class="alpheios-lex-greek" lang="grc">γώνυμος:</span></b> 
			<span class="alpheios-lex-greek" lang="grc">φερώνυμος,</span> Id. <b><span class="alpheios-lex-greek" lang="grc">γῶος:</span></b> 
			<span class="alpheios-lex-greek" lang="grc">μνημεῖον,</span> Id. <b><span class="alpheios-lex-greek" lang="grc">γωροῦται:</span></b> 
			<span class="alpheios-lex-greek" lang="grc">σαρκοῖ</span> (
				Lacon.
			), Id.</div>
