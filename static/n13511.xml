				 <i><span class="en">
					Od.
					22.82
				</span></i>
			; <i>let fall,</i> [<span class="alpheios-lex-greek" lang="grc">ξίφος]
				ἀποπροέηκε χαμᾶζε</span> ib.<i><span class="en">
				327
			</span></i>.</div>
