    <div class="alpheios-lex-entry" lemma-id="n42450" body-key=""><b><span class="alpheios-lex-greek" lang="grc">ἐρῐθηλής</span></b> , <span class="alpheios-lex-greek" lang="grc">ές</span>,
			(<span class="alpheios-lex-greek" lang="grc">θάλλω</span>) <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b><i>very flourishing, luxuriant,</i> of plants, 
				“<span class="alpheios-lex-greek" lang="grc">μυρίκης τ᾽ ἐριθηλέας ὄζους</span>”
				 <i><span class="en">
					Il.
					10.467
				</span></i>
			 ; 
				“<span class="alpheios-lex-greek" lang="grc">ἔρνος..ἐριθηλὲς ἐλαίης</span>”
				 <i><span class="en">
					17.53
				</span></i>
			 ; 
				“<span class="alpheios-lex-greek" lang="grc">δάφνης ἐριθηλέος ὄζον</span>”
				 <i><span class="en">
					Hes.
					<u>Th.</u>
					30
				</span></i>
			 ; of gardens, 
				“<span class="alpheios-lex-greek" lang="grc">ἀλωάων ἐριθηλέων</span>”
				 <i><span class="en">
					Il.
					5.90
				</span></i>
			 ; 
				“<span class="alpheios-lex-greek" lang="grc">γαῖα</span>”
				 <i><span class="en">
					A.R.
					2.723
				</span></i>
			 : metaph., 
				“<span class="alpheios-lex-greek" lang="grc">εὐνομία</span>”
				 <i><span class="en">
					<u>APl.</u>
					4.72.5
				</span></i>
			, cf. <i><span class="en">
				Orph.
				<u>Fr.</u>
				142
			</span></i>, <i><span class="en">
				206
			</span></i>.</div>
