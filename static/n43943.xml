				 <i><span class="en">
					A.
					<u>Fr.</u>
					300.5
				</span></i>
			; 
				“<span class="alpheios-lex-greek" lang="grc">γῆρας</span>”
				 <i><span class="en">
					Men.
					<u>Mon.</u>
					388
				</span></i>
			; 
				“<span class="alpheios-lex-greek" lang="grc">ἄνηθον</span>”
				 <i><span class="en">
					Mosch.
					3.100
				</span></i>
			, cf. <i><span class="en">
				<u>AP</u>
				9.3
			</span></i> (Antip.), <i><span class="en">
				Orph.
				<u>A.</u>
				912
			</span></i>; 
				“<span class="alpheios-lex-greek" lang="grc">χάριτες</span>”
				 <i><span class="en">
					<u>AP</u>
					7.600
				</span></i>
