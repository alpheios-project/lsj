    <div class="alpheios-lex-entry" lemma-id="n93859" body-key=""><b><span class="alpheios-lex-greek" lang="grc">σηραγγώδης</span></b> , <span class="alpheios-lex-greek" lang="grc">ες</span>,
			<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b><i>full of holes</i> or
				<i>caverns</i>, 
				“<span class="alpheios-lex-greek" lang="grc">Ἴδη</span>”
				 <i><span class="en">
					Paus.
					10.12.4
				</span></i>
			, cf. <i><span class="en">
				D.C.
				48.51
			</span></i>, <i><span class="en">
				Agath.
				2.15
			</span></i>, <i><span class="en">
				Lyd.
				<u>Ost.</u>
				53
			</span></i>. </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense3"><b>2.</b>
			<i>porous, spongy</i>, <i><span class="en">
				Hp.
				<u>VC</u>
				1
			</span></i>, al.; 
				“<span class="alpheios-lex-greek" lang="grc">θηλαί</span>”
				 <i><span class="en">
					Sor.
					1.88
				</span></i>
			; 
				“<span class="alpheios-lex-greek" lang="grc">νεῦρον</span>”
				 <i><span class="en">
					Gal.
					10.968
				</span></i>
			.</div>
