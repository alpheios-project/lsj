    <div class="alpheios-lex-entry" lemma-id="n27575" body-key=""><b><span class="alpheios-lex-greek" lang="grc">δῐφάσιος</span></b>  [<span class="alpheios-lex-greek" lang="grc">ᾰ], <span class="alpheios-lex-greek" lang="grc">α</span>, <span class="alpheios-lex-greek" lang="grc">ον</span>,</span>
		
