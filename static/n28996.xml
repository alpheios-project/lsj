			; <span class="alpheios-lex-greek" lang="grc">χεῖμα δ.</span>, <i>hiems
			ignava</i>, <i><span class="en">
				Bion
				<u>Fr.</u>
				15.5
			</span></i>; <i>idle</i>, 
				“<span class="alpheios-lex-greek" lang="grc">νωθρὸς καὶ δ.</span>”
				 <i><span class="en">
					Plu.
					<u>Alex.</u>
					33
				</span></i>
			.</div>
