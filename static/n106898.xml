    <div class="alpheios-lex-entry" lemma-id="n106898" body-key=""><b><span class="alpheios-lex-greek" lang="grc">ὕπανδρος</span></b> , <span class="alpheios-lex-greek" lang="grc">ον</span>,
			(<span class="alpheios-lex-greek" lang="grc">ἀνήρ</span>) <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b><i>under a man, subject to him, married,</i>
			
				“<span class="alpheios-lex-greek" lang="grc">γυνή</span>”
				 <i><span class="en">
					LXX
					<u>Nu.</u>
					5.20
				</span></i>
			, <i><span class="en">
				Plb.
				10.26.3
			</span></i>, <i><span class="en">
				<u>Ep.Rom.</u>
				7.2
			</span></i>, etc.; 
				“<span class="alpheios-lex-greek" lang="grc">τὰς ὑ. τῶν γυναικῶν</span>”
				 <i><span class="en">
					Polem.Hist.
					59
				</span></i>
			; 
				“<span class="alpheios-lex-greek" lang="grc">ὕ. γύναια</span>”
				 <i><span class="en">
					Plu.
					<u>Pel.</u>
					9
				</span></i>
			. </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>II.</b>
			<i>feminine,</i>
			<span class="alpheios-lex-greek" lang="grc">ἀγωγὴ οἰκουρὸς καὶ ὕ.</span> a
				<i>feminine</i> mode of life, <i><span class="en">
				D.S.
				32.10
			</span></i>.</div>
