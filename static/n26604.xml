<div xmlns:perseus="http://www.perseus.org/meta/perseus.rdfs#" xmlns:dctype="http://purl.org/dc/dcmitype/" xmlns:tufts="http://www.tufts.edu/" xmlns:alph="http://alpheios.net/namespaces/tei" class="alpheios-lex-text_container en">
    <div class="alpheios-lex-entry" lemma-id="n26604" body-key=""><b><span class="alpheios-lex-greek" lang="grc">διεξ-ελαύνω</span></b> , 
			Att.
		
		fut.
		<span class="alpheios-lex-greek" lang="grc">-ελῶ</span>: intr., <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b><i>drive, ride, march through,</i> abs., <i><span class="en">
				Hdt.
				1.187
			</span></i>: c. acc. loci, 
				“<span class="alpheios-lex-greek" lang="grc">δ. τὴν ἄνυδρον</span>”
				 <i><span class="en">
					Id.
					3.11
				</span></i>
			; 
				“<span class="alpheios-lex-greek" lang="grc">τὰς πύλας</span>”
				 <i><span class="en">
					Id.
					5.52
				</span></i>
			, etc.; also 
				“<span class="alpheios-lex-greek" lang="grc">κατὰ τὸ προάστειον</span>”
				 <i><span class="en">
					Id.
					3.86
				</span></i>
			; 
				“<span class="alpheios-lex-greek" lang="grc">δ. ἐπὶ ἅρματος</span>”
				 <i><span class="en">
					Id.
					7.100
				</span></i>
			; 
				“<span class="alpheios-lex-greek" lang="grc">δ. ἵππῳ τὸν πόρον</span>”
				 <i><span class="en">
					Plu.
					<u>Publ.</u>
					19
				</span></i>
			: c. gen. loci, 
				“<span class="alpheios-lex-greek" lang="grc">δ. τῆς Ῥώμης</span>”
				 <i><span class="en">
					Id.
					<u>Cam.</u>
					7
				</span></i>
			.</div>
