    <div class="alpheios-lex-entry" lemma-id="n67470" body-key=""><b><span class="alpheios-lex-greek" lang="grc">μηνιαῖος</span></b> , <span class="alpheios-lex-greek" lang="grc">α</span><span class="alpheios-lex-greek" lang="grc">, ον </span>(<span class="alpheios-lex-greek" lang="grc">ος</span>, <span class="alpheios-lex-greek" lang="grc">ον</span>
		<i><span class="en">
			Antyll.
		</span></i> ap. <i><span class="en">
			Orib.
			9.3.1
		</span></i>), <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b><i>monthly</i>, 
				“<span class="alpheios-lex-greek" lang="grc">ἀπόκρυψις</span>”
				 <i><span class="en">
					<u>Placit.</u>
					2.29.5
				</span></i>
			; 
				“<span class="alpheios-lex-greek" lang="grc">περίοδος</span>”
				 <i><span class="en">
					Str.
					3.5.8
				</span></i>
			, <i><span class="en">
				Gal.
				7.500
			</span></i>; 
				“<span class="alpheios-lex-greek" lang="grc">φορά</span>”
				 <i><span class="en">
					<u>IG</u>
					22.1368.46
				</span></i>
			; 
				“<span class="alpheios-lex-greek" lang="grc">διαγραφή</span>”
				 <i><span class="en">
					<u>PRyl.</u>
					2.206
				</span></i>
			(<i>b</i>) <span class="entity">(iii A.D.)</span>; <span class="alpheios-lex-greek" lang="grc">τὰ μ.</span> the <i>menses</i> of women, <i><span class="en">
