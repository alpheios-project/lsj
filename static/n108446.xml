    <div class="alpheios-lex-entry" lemma-id="n108446" body-key=""><b><span class="alpheios-lex-greek" lang="grc">ὑποθῡμίς</span></b> , 
			Aeol.
		
		<b><span class="alpheios-lex-greek" lang="grc">ὐπά-</span></b> , <span class="alpheios-lex-greek" lang="grc">ίδος</span>, ἡ, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b><i>garland worn on the neck, that one may enjoy the
				sweetness of the flowers,</i>
			<i><span class="en">
				Anacr.
				39
			</span></i>, <i><span class="en">
				Sapph.
				<u>Supp.</u>
				23.15
			</span></i>, <i><span class="en">
				Alc.
				36
			</span></i> (<span class="alpheios-lex-greek" lang="grc">ὑποθυμιάδας</span> codd.).
			</div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense3"><b>2.</b>
			
				=
				<span class="alpheios-lex-greek" lang="grc">ὑπογλωττίς</span>
			
			<i><span class="en">
				11
			</span></i>, <i><span class="en">
				Philet.
			</span></i> ap. <i><span class="en">
				Ath.
				15.678d
			</span></i>. </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>II.</b>
			<b><span class="alpheios-lex-greek" lang="grc">ὑποθῠμίς</span></b> , an unknown
			bird, <i><span class="en">
				Ar.
				<u>Av.</u>
				302
			</span></i> (troch.).</div>
