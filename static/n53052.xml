    <div class="alpheios-lex-entry" lemma-id="n53052" body-key=""><b><span class="alpheios-lex-greek" lang="grc">κάναστρον</span></b> 
		<span class="alpheios-lex-greek" lang="grc">[κᾰ]</span>, τό, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b>
				=
				<span class="alpheios-lex-greek" lang="grc">κάνεον</span>
			, <i>wicker basket</i>, <i><span class="en">
				<u>GDI</u>
				5087.9
			</span></i> (<span class="entity">Crete</span>), dub. in <i><span class="en">
				<u>Supp.Epigr.</u>
				1.414
			</span></i> (<span class="entity">Crete</span>), cf. <i><span class="en">
				Hsch.
			</span></i>: <b><span class="alpheios-lex-greek" lang="grc">καναῦστρον</span></b> , <i><span class="en">
				<u>IG</u>
				12.330.11
			</span></i> (cited as <b><span class="alpheios-lex-greek" lang="grc">κάναστρον</span></b> 
			and <b><span class="alpheios-lex-greek" lang="grc">κάνυστρον</span></b>  by <i><span class="en">
				Poll.
				10.86
			</span></i>), cf. <i><span class="en">
				<u>Carm.Pop.</u>
				41.9
			</span></i>; <b><span class="alpheios-lex-greek" lang="grc">κάνιστρον</span></b>  (?),
				<i><span class="en">
				<u>PLond.</u>
				5.1657.9
			</span></i>
			<span class="entity">(iv/v A.D.)</span>. </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>II.</b>
			<i>earthen vessel, dish</i>, 
				=
				<span class="alpheios-lex-greek" lang="grc">τρύβλιον</span>
			, <i><span class="en">
				Hom.
				<u>Epigr.</u>
				14.3
			</span></i>, <i><span class="en">
				Nicopho
				24
			</span></i>.</div>
