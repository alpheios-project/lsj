    <div class="alpheios-lex-entry" lemma-id="n114299" body-key=""><b><span class="alpheios-lex-greek" lang="grc">χοιρο-γρύλλιος</span></b> , ὁ,
			= Heb. <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b><i>shâphân, Hyrax syriacus, coney,</i>
			<i><span class="en">
				LXX
				<u>Le.</u>
				11.6
			</span></i>, <i><span class="en">
				<u>De.</u>
				14.7
			</span></i>, <i><span class="en">
				<u>Ps.</u>
				103(104).18
			</span></i>, <i><span class="en">
				<u>Pr.</u>
				24.61
			</span></i>(<i><span class="en">
				30.26
			</span></i>); also <b><span class="alpheios-lex-greek" lang="grc">χοιρό-γρυλλος</span></b> , <i><span class="en">
				<u>PMag.Leid.V.</u>
				12.28
			</span></i>, <u>Gloss.</u>; wrongly expld. by <i><span class="en">
				Hsch.
			</span></i> (who makes it neut.) and <i><span class="en">
				Suid.
			</span></i> as <span class="alpheios-lex-greek" lang="grc">ἀκανθόχοιρος, ὕστριξ, ἐχῖνος
				χερσαῖος.</span></div>
