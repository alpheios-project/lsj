    <div class="alpheios-lex-entry" lemma-id="n38288" body-key=""><b><span class="alpheios-lex-greek" lang="grc">ἐπᾰράσσὼ</span></b> , 
			Att.
		
		<b><span class="alpheios-lex-greek" lang="grc">ἐπαπό-ττω</span></b> , <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b><i>dash</i> or <i>clap to,</i>
			
				“<span class="alpheios-lex-greek" lang="grc">τὴν θύραν</span>”
				 <i><span class="en">
					Pl.
					<u>Prt.</u>
					314d
				</span></i>
			, cf. <i><span class="en">
				Plu.
				<u>Art.</u>
				29
			</span></i>; 
				“<span class="alpheios-lex-greek" lang="grc">τὸν πῆχυν τῷ αὐχένι ὥσπερ μοχλόν</span>”
				 <i><span class="en">
					Hld.
					10.31
				</span></i>
			; <span class="alpheios-lex-greek" lang="grc">ναρθήκια κατὰ τῶν ἰσχνῶν μορίων
				ἐ.</span>
			<i>strike</i> rods <i>against</i> the thin parts, <i><span class="en">
				Gal.
				10.998
			</span></i>.</div>
