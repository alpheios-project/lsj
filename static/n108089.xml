				 <i><span class="en">
					A.
					<u>Eu.</u>
					121
				</span></i>
			, cf. <i><span class="en">
				124
			</span></i>, <i><span class="en">
				Hp.
				<u>Epid.</u>
				7.11
			</span></i> (v. 
				“<span class="alpheios-lex-greek" lang="grc">ὑπνόω</span>”
