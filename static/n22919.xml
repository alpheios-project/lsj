    <div class="alpheios-lex-entry" lemma-id="n22919" body-key=""><b><span class="alpheios-lex-greek" lang="grc">γρύψ</span></b> , gen. <span class="alpheios-lex-greek" lang="grc">γρῡπός, ὁ</span>, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b><i>griffin</i>, Aristeasap. <i><span class="en">
				Hdt.
				3.116
			</span></i>, cf. <i><span class="en">
				4.13
			</span></i>, <i><span class="en">
				A.
				<u>Pr.</u>
				804
			</span></i>, <i><span class="en">
				<u>IG</u>
				12.280.80
			</span></i>; 
				“<span class="alpheios-lex-greek" lang="grc">τράπεζα ἔχουσα πόδας ἀναγλύπτους
					γρῦπας</span>”
				 <i><span class="en">
					<u>SIG</u>
					996.10
				</span></i>
			 (<span class="entity">Smyrna</span>). </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>II.</b> a bird, prob. the
			<i>Lämmergeier</i>, <i><span class="en">
				LXX
				<u>Le.</u>
				11.13
			</span></i>, <i><span class="en">
				<u>De.</u>
				14.13
			</span></i>. </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>III.</b> pl., part
			of a ship's <i>tackle</i>, or <i>anchor</i>, <i><span class="en">
				Hsch.
			</span></i></div>
