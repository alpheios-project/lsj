    <div class="alpheios-lex-entry" lemma-id="n109196" body-key=""><b><span class="alpheios-lex-greek" lang="grc">ὑποστά̆τ-ης</span></b> , <span class="alpheios-lex-greek" lang="grc">ου</span>,
			ὁ, <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b><i>that which stands under, support, prop,</i>
			<i><span class="en">
				Plu.
				<u>Cor.</u>
				24
			</span></i>; <i>stand</i> of a bowl, etc., <i><span class="en">
				Paus.
				10.26.9
			</span></i>. </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>II.</b>
			<i>one that gives substance, creator,</i>
			<i><span class="en">
				Procl.
				<u>Theol.Plat.</u>
				3.7
			</span></i>, <i><span class="en">
				<u>Inst.</u>
				53
			</span></i>, <i><span class="en">
				Simp.
				<u>in Ph.</u>
				1327.5
			</span></i>.</div>
