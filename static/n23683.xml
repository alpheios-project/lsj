<div xmlns:perseus="http://www.perseus.org/meta/perseus.rdfs#" xmlns:dctype="http://purl.org/dc/dcmitype/" xmlns:tufts="http://www.tufts.edu/" xmlns:alph="http://alpheios.net/namespaces/tei" class="alpheios-lex-text_container en">
    <div class="alpheios-lex-entry" lemma-id="n23683" body-key=""><b><span class="alpheios-lex-greek" lang="grc">δειλινός</span></b> , <span class="alpheios-lex-greek" lang="grc">ή</span>,
			<span class="alpheios-lex-greek" lang="grc">όν</span><span class="alpheios-lex-greek" lang="grc">,
			ʽδείλἠ</span>
		<div class="alpheios-lex-lex_sense alpheios-lex-lex_sense1"><b>A.</b>
				=
				<span class="alpheios-lex-greek" lang="grc">δειελινός</span>
			, <i>in the afternoon,</i>
			
				“<span class="alpheios-lex-greek" lang="grc">δ. ἤρξατο</span>”
				 <i><span class="en">
					<u>Com.Adesp.</u>
					609
				</span></i>
			, cf. <i><span class="en">
				Luc.
				<u>Dem.Enc.</u>
				31
			</span></i>, <i><span class="en">
				Secund.
				<u>Sent.</u>
				4
			</span></i>, <i><span class="en">
				<u>BGU</u>
				513.3
			</span></i>
			<span class="entity">(ii A.D.)</span>; <span class="alpheios-lex-greek" lang="grc">τὸ δ.,</span> as
				Adv., <i>at even,</i>
			<i><span class="en">
				LXX
				<u>Ge.</u>
				3.8
			</span></i>, <i><span class="en">
				Luc.
				<u>Lex.</u>
				2
			</span></i>; 
				“<span class="alpheios-lex-greek" lang="grc">δ. ὁλοκαύτωμα</span>”
				 <i><span class="en">
					LXX
					<u>1 Es.</u>
					5.50
				</span></i>
			; 
				“<span class="alpheios-lex-greek" lang="grc">ὧραι</span>”
				 <i><span class="en">
					Str.
					17.3.8
				</span></i>
			; 
				“<span class="alpheios-lex-greek" lang="grc">ἑσπέρα</span>”
				 <i><span class="en">
					Ph.
					1.505
				</span></i>
			 (s.v.l.); 
				“<span class="alpheios-lex-greek" lang="grc">διατριβή</span>”
				 <i><span class="en">
					Plu.
					2.70e
				</span></i>
			. </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense3"><b>2.</b>
			<i>western,</i>
			
				“<span class="alpheios-lex-greek" lang="grc">κλίμα</span>”
				 <i><span class="en">
					Str.
					9.2.41
				</span></i>
			. </div>
        <div class="alpheios-lex-lex_sense alpheios-lex-lex_sense2"><b>II.</b>
			<span class="alpheios-lex-greek" lang="grc">τὸ δ.</span> (sc. <span class="alpheios-lex-greek" lang="grc">δεῖπνον</span>) <i>evening meal,</i>
			f.l. in
			<i><span class="en">
				Ath.
				10.418b
			</span></i> (quoting <i><span class="en">
				Plb.
				20.6.6
			</span></i>), cf. <i><span class="en">
				Ath.
				1.11e
			</span></i>.</div>
